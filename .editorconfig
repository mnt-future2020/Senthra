# EditorConfig — https://editorconfig.org
# Enforces UTF-8 + LF on save across editors (VS Code, JetBrains, …). The UTF-8
# charset rule is the guard against mojibake: characters like the em dash "—" stay
# valid bytes instead of being re-saved through a legacy code page (which is how
# "—" turned into "â€"" in the source once before).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,md,prisma}]
indent_style = space
indent_size = 2

# Markdown: trailing whitespace can be a meaningful line break — don't strip it.
[*.md]
trim_trailing_whitespace = false
