# Backend base URL (no trailing slash).
#   iOS simulator:      http://localhost:8000
#   Android emulator:   http://10.0.2.2:8000
#   Physical device:    http://<your-LAN-IP>:8000  (backend and phone on the same network)
#   Production:         https://api.your-domain.com  (HTTPS required — auth cookies are Secure in prod)
EXPO_PUBLIC_API_URL=http://localhost:8000
