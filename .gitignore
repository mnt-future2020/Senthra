# Root ignores for the Senthra project.
# Per-project rules live in backend/.gitignore and frontend/.gitignore.

# Dependencies (defensive — should not exist at the root)
node_modules/

# OS junk (patterns without a slash apply to every subfolder)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# Qodo AI workspace (local, regenerated)
.qodo/

# Claude Code — ignore the per-machine local config.
.claude/settings.local.json

# Agent instruction files and internal design docs: LOCAL ONLY, never pushed.
# They stay on disk and keep working for the tooling that reads them — they are
# untracked (git rm --cached), not deleted. The .md summaries the client sees
# (PROJECT-DOCUMENTATION.md, the per-app READMEs) and docs/diagrams/*.png stay tracked.
/CLAUDE.md
/frontend/CLAUDE.md
/frontend/AGENTS.md
/mobile/CLAUDE.md
/mobile/AGENTS.md
/docs/*.md
/docs/superpowers/

# Logs
*.log

# Frozen UI reference snapshot — local only.
# A read-only copy of the starter dashboard's demo screens (see reference/README.md).
# It is outside frontend/ and backend/, so nothing type-checks, lints, bundles or imports
# it — only a handful of code comments point at it by name. Untracked so it stops riding
# along in every clone and diff. Earlier revisions remain in git history, so the snapshot
# is still recoverable with `git show <commit>:reference/<file>`.
reference/

# Binary client / reference docs — keep the .md summaries tracked, ignore the
# source binaries (PDFs, Word, Excel: client inputs, job packs, samples, etc.)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt

# Safety net: never commit real secrets anywhere in the tree.
# (.env.example templates are still allowed.)
.env
.env.*
!.env.example
