// Prisma schema — MongoDB. See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the Vercel serverless
  // runtime (Amazon Linux) — needed so the query engine binary exists there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// The admin account. Seeded from ADMIN_EMAIL / ADMIN_PASSWORD on first startup.
// MongoDB ids map to the `_id` ObjectId field.
model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  // Optional Google account email allowed to sign in (defaults to `email`).
  googleEmail  String?
  // Password reset: SHA-256 hash of the emailed token + its expiry (never the raw token).
  resetTokenHash     String?
  resetTokenExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Application settings (singleton). Holds the Google OAuth + SMTP email config so
// they can be configured from the dashboard Settings UI rather than hardcoded.
model Settings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId

  // --- Google Sign-In (OAuth) ---
  googleEnabled      Boolean  @default(false)
  googleClientId     String?
  googleClientSecret String?

  // --- SMTP email delivery ---
  smtpEnabled        Boolean  @default(false)
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean  @default(false) // true = implicit TLS (port 465); false = STARTTLS (587)
  smtpUsername       String?
  smtpPassword       String?  // never returned to the client
  smtpFromName       String?
  smtpFromEmail      String?

  // --- Cloudinary (image CDN) — UI-configurable; secret encrypted at rest ---
  cloudinaryCloudName String?
  cloudinaryApiKey    String?
  cloudinaryApiSecret String?  // never returned to the client

  // --- Branding (all public; logo/favicon are Cloudinary URLs) ---
  brandName          String?
  brandColor         String?  // hex accent used across the app + sent emails
  logoUrl            String?
  faviconUrl         String?
  footerText         String?
  loginHeadline      String?
  loginSubtext       String?
  // Code prefixed to new staff references (e.g. "SNT" -> SNT-0007). Decoupled from
  // brandName on purpose: renaming the brand must not silently change permanent
  // employee IDs. Null falls back to the default. Only affects NEW staff.
  employeeIdPrefix   String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A role a user can be assigned. Seeded with the Senthra domain roles.
// `permissions` holds the delegatable permission keys the role grants
// ("*" = full access); the super-admin configures them.
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // stable machine key, e.g. "field_engineer"
  name        String // display name, e.g. "Field Engineer"
  description String?
  isSystem    Boolean  @default(false) // seeded role → cannot be deleted
  permissions String[] @default([]) // RESERVED for future RBAC (empty for now)
  sortOrder   Int      @default(0)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // auto slug from name: "Optical" -> "optical"
  name        String // display name exactly as typed
  // Lowercased `name`, kept in sync by the repository on every write. The @unique
  // index here is what actually enforces case-insensitive name uniqueness at the DB
  // (the `key` slug can legitimately collide for punctuation-only-distinct names, so
  // it can't carry this guard); the application pre-check is just for a friendly message.
  nameLower   String   @unique
  description String?
  status      String   @default("active") // active | inactive
  sortOrder   Int      @default(0)
  items       CustomerCatalogueItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Employee master-data: a department a staff member belongs to (e.g. "Operations").
// Managed (create/rename/delete) from Users & Roles; the user form picks from this
// list or creates one inline. User.department stores the chosen NAME (denormalized),
// so existing records stay valid and removing a department never orphans a user.
model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Display name exactly as typed ("Operations"). Not unique on its own — the
  // case-insensitive guard lives on `nameLower` so "Operations" and "operations"
  // can't both exist.
  name      String
  // Lowercased `name`, kept in sync by the repository on every write. The @unique
  // index here is what actually enforces case-insensitive uniqueness at the DB —
  // the application pre-check is just for a friendly message.
  nameLower String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Employee master-data: a job title / designation (e.g. "Field Engineer"). Managed
// from Users & Roles; the user form picks from this list or creates one inline.
// User.jobTitle stores the chosen NAME (denormalized), so a rename cascades and a
// removal never orphans a user. Case-insensitive uniqueness via nameLower (same
// pattern as Department).
model JobTitle {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  nameLower String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staff member the Super Admin (or a delegate with users.create) adds from the
// admin panel. Created with a secure temporary password (bcrypt hash, never sent
// to the client); logs in and is governed by RBAC via the assigned role.
model User {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String  @unique
  phone           String?
  roleId          String? @db.ObjectId
  role            Role?   @relation(fields: [roleId], references: [id])
  status          String  @default("active") // active | inactive | suspended
  profileImageUrl String?
  notes           String?

  // Employment record.
  employeeId    String?   @unique // human staff reference, auto-generated (e.g. SNT-0007)
  jobTitle      String? // designation, e.g. "Field Engineer"
  department    String? // team, e.g. "Operations"
  dateOfJoining DateTime?

  // Personal details (optional).
  gender      String? // male | female | other | unspecified
  dateOfBirth DateTime?

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?

  // Auth — set at creation, never sent to the browser.
  passwordHash      String
  mustResetPassword Boolean @default(true)
  // First-login "set your password" + forgot-password flow: SHA-256 hash of the
  // emailed token + its expiry (never the raw token).
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  deletedAt DateTime? // soft delete — excluded from listings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
}

// A customer company (e.g. "BT"). Created by an admin/PM from the dashboard; the
// record IS the login identity (one read-only login per customer — company email +
// temp password, mirroring the staff User auth fields). A Customer PM signs in and
// gets READ-ONLY, single-customer-scoped visibility of their own stock (Flow 9).
// Customer codes are Counter-allocated (e.g. CUST-001), same pattern as employeeId.
model Customer {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  customerCode  String  @unique // human reference, auto-generated (e.g. CUST-001)
  name          String // company name, e.g. "BT"
  // Lowercased `name`, kept in sync by the repository on every write. NOT a hard
  // unique index (a soft-deleted row would otherwise permanently block re-using a
  // company name); case-insensitive name uniqueness is checked among ACTIVE
  // customers in the service. `email` is the hard unique login identity.
  nameLower     String

  // Company details.
  legalName          String? // legal / registered company name (distinct from trading name)
  registrationNumber String? // company / registration number
  industry           String? // sector, e.g. "Telecoms"
  website            String?
  logoUrl            String? // Cloudinary URL (company logo)
  notes              String? // internal notes (never shown to the customer)
  status             String  @default("active") // active | inactive

  // Primary contact (the portal login belongs to this person).
  contactPerson   String?
  contactJobTitle String?
  email           String  @unique // login identity (company email)
  phone           String?
  altPhone        String? // secondary phone

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? // defaults to "United Kingdom" in the UI

  // The login identity now lives on CustomerUser (a person signs in, not the
  // company). `email` above is just the company's primary-contact email.

  deletedAt DateTime? // soft delete — excluded from listings

  // Audit — staff email that created / last updated this record (null for legacy rows).
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      CustomerProject[]
  catalogue     CustomerCatalogueItem[]
  sites         CustomerSite[]
  users         CustomerUser[]
  stockRequests CustomerStockRequest[]

  @@index([status])
}

// A customer's project (e.g. "BT Core Migration"). 1-to-many. Later feeds the
// "Select Project" dropdown when creating jobs. Case-insensitive unique per customer.
model CustomerProject {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String    @db.ObjectId
  customer    Customer  @relation(fields: [customerId], references: [id])
  // Per-customer reference, auto-generated by the atomic counter (e.g. PRJ-0001).
  // Required: the service always allocates one on create (DB is clean of legacy rows).
  code        String
  name        String
  nameLower   String    // lowercased name; uniqueness scoped per-customer via @@unique
  type        String?   // project type, e.g. "Migration" | "Rollout"
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active") // active | planned | on_hold | completed
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, nameLower])
  @@index([customerId])
}

// An item in a customer's stock catalogue. Per-customer SKUs (no fixed format).
// `attributes` holds dynamic per-category custom fields (e.g. Fibre: Singlemode).
// SKU is case-insensitive unique per customer. NO pricing/cost fields ever live
// here — customers must never see monetary data.
model CustomerCatalogueItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String   @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  name            String
  sku             String
  skuLower        String   // lowercased sku; uniqueness scoped per-customer via @@unique
  categoryId      String   @db.ObjectId
  category        Category @relation(fields: [categoryId], references: [id])
  description     String?
  uom             String?  // unit of measure, e.g. "Each" | "Metre"
  serialized      Boolean  @default(false) // tracked by serial number
  barcodeRequired Boolean  @default(false)
  highValue       Boolean  @default(false)
  thresholdQty    Int?     // low-stock reorder threshold (genuinely optional)
  status          String   @default("active") // active | inactive
  attributes      Json?    // dynamic per-category custom fields
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([customerId, skuLower])
  @@index([customerId])
  @@index([categoryId])
}

// A customer site / delivery location (optional). name + UK postcode.
model CustomerSite {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id])
  // Per-customer reference, auto-generated by the atomic counter (e.g. STE-0001).
  // Required: the service always allocates one on create (DB is clean of legacy rows).
  code          String
  name          String
  addressLine   String?  // street address (postcode kept separate)
  postcode      String?
  contactPerson String?
  contactNumber String?
  latitude      Float?
  longitude     Float?
  status        String   @default("active") // active | inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

// A customer's portal user (e.g. their PM) — and the customer's LOGIN identity.
// 1-to-many under a company; each user signs in with their own email + password.
// One user type for now (no per-user roles). `email`/`emailLower` are globally
// unique (the customer login namespace); auth fields mirror the staff User.
model CustomerUser {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String    @db.ObjectId
  customer    Customer  @relation(fields: [customerId], references: [id])
  fullName    String
  email       String
  emailLower  String    @unique // lowercased login email — globally unique
  phone       String?
  designation String?   // job title / role label (free text)
  status      String    @default("active") // active | inactive

  // Auth — set when the user is invited; never sent to the browser. Optional so a
  // pre-existing contact row still reads (it just can't log in until invited).
  passwordHash        String?
  mustResetPassword   Boolean?  @default(true)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  lastLoginAt         DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
}

// A customer-submitted STOCK REQUEST — an order / replenishment ask, NOT a catalogue
// write. A portal user asks for an item + quantity with a business reason; an internal
// user with customers.edit reviews it (pending → approved / rejected, and later
// completed once fulfilled). A request NEVER creates a catalogue or inventory record
// directly — fulfilment is a separate, deliberate admin/inventory step.
model CustomerStockRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id])
  name        String   // requested item name
  // quantity + reason are MANDATORY in validation (zod), but DB-nullable on purpose:
  // Prisma+MongoDB throws reading a doc that LACKS a required field, so new required
  // fields stay nullable at the DB and the API enforces them.
  quantity    Int?
  reason      String?  // business justification (app-required)
  notes       String?
  status            String    @default("pending") // pending | approved | rejected | completed
  requestedByUserId String?   @db.ObjectId
  requestedByName   String?
  reviewedBy        String?   // staff email that approved / rejected
  adminResponse     String?   // admin response notes (shown to the customer)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
}

// A dynamic, admin-editable email template. Every email the app sends is
// rendered from one of these (no hardcoded email content). `isSystem` templates
// ship a built-in default that can be restored but not deleted.
model EmailTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // event key, e.g. "user.created"
  name        String // "User Created"
  category    String // account | security | notification
  subject     String
  htmlContent String
  textContent String
  variables   String[] @default([]) // supported {{vars}} (for UI hints)
  enabled     Boolean  @default(true)
  isSystem    Boolean  @default(false) // has a built-in default → restore / no-delete
  version     Int      @default(1) // bumps on each edit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Delivery log for every email send (templated or test). Failed-email tracking
// = rows where status = "failed"; retry-ready for a later phase.
model EmailLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  to          String
  subject     String
  templateKey String? // null for ad-hoc sends (e.g. a test email)
  status      String // sent | failed
  error       String?
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
}

// Immutable audit trail. The actor is snapshotted (id + email) so the entry
// stays meaningful even if that account is later renamed or removed.
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId     String?
  actorType   String   @default("admin") // admin | user | system
  actorEmail  String?
  action      String // "user.created", "role.deleted", ...
  targetType  String? // user | role | email_template
  targetId    String?
  targetLabel String? // snapshot, e.g. the user's email / role name
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// An active login session = one signed-in device. Tokens carry the `sid`, and
// requireAuth + refresh validate that the session row still exists — so logout
// and the 2-device cap (evicting the oldest session on a 3rd sign-in) take effect
// immediately. Rows are deleted on logout / password change.
model Session {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  sid           String   @unique // embedded in the access + refresh tokens
  principalId   String // the admin, user, or customer id (no FK — points at any collection)
  principalType String // "admin" | "user" | "customer"
  userAgent     String?
  ip            String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  expiresAt     DateTime // matches the refresh token's expiry

  @@index([principalId, principalType])
}

// A named, atomically-incrementing sequence. Used to hand out gap-free, collision-free
// running numbers — currently the employeeId suffix, one sequence per prefix. `key` is
// the sequence name (the employeeId prefix, e.g. "STR"); `seq` is the last value handed
// out. Allocation is a single atomic $inc on this one document, so concurrent callers
// can never receive the same number (no retry, no random fallback). On first use of a
// prefix the row is seeded from the highest existing id so it never reuses a number.
model Counter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // sequence name, e.g. the employeeId prefix "STR"
  seq       Int      @default(0) // last value handed out
  updatedAt DateTime @updatedAt
}
