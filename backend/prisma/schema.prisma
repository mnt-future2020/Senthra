// Prisma schema — MongoDB. See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the Vercel serverless
  // runtime (Amazon Linux) — needed so the query engine binary exists there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// The admin account. Seeded from ADMIN_EMAIL / ADMIN_PASSWORD on first startup.
// MongoDB ids map to the `_id` ObjectId field.
model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  // Optional Google account email allowed to sign in (defaults to `email`).
  googleEmail  String?
  // Password reset: SHA-256 hash of the emailed token + its expiry (never the raw token).
  resetTokenHash     String?
  resetTokenExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Application settings (singleton). Holds the Google OAuth + SMTP email config so
// they can be configured from the dashboard Settings UI rather than hardcoded.
model Settings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId

  // --- Google Sign-In (OAuth) ---
  googleEnabled      Boolean  @default(false)
  googleClientId     String?
  googleClientSecret String?

  // --- SMTP email delivery ---
  smtpEnabled        Boolean  @default(false)
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean  @default(false) // true = implicit TLS (port 465); false = STARTTLS (587)
  smtpUsername       String?
  smtpPassword       String?  // never returned to the client
  smtpFromName       String?
  smtpFromEmail      String?

  // --- Cloudinary (image CDN) — UI-configurable; secret encrypted at rest ---
  cloudinaryCloudName String?
  cloudinaryApiKey    String?
  cloudinaryApiSecret String?  // never returned to the client

  // --- Branding (all public; logo/favicon are Cloudinary URLs) ---
  brandName          String?
  brandColor         String?  // hex accent used across the app + sent emails
  logoUrl            String?
  faviconUrl         String?
  footerText         String?
  loginHeadline      String?
  loginSubtext       String?
  // Code prefixed to new staff references (e.g. "SNT" -> SNT-0007). Decoupled from
  // brandName on purpose: renaming the brand must not silently change permanent
  // employee IDs. Null falls back to the default. Only affects NEW staff.
  employeeIdPrefix   String?
  // Display prefix for CUSTOMER stock-entry (consignment) barcodes (e.g. "CSE" -> CSE-00006).
  // Only the human-readable prefix is configurable — the underlying sequence
  // counter is a fixed internal namespace, so changing this never resets or
  // collides numbering. Null falls back to the default. Only affects NEW barcodes.
  stockCodePrefix    String?
  // Display prefix for IRM catalogue ITEM codes (e.g. "IRM" -> IRM-0004). Same rule: the
  // numeric sequence lives under a fixed internal counter, so changing this never resets or
  // collides numbering and EXISTING item codes are immutable. Only affects NEW items.
  irmCodePrefix      String?

  // --- Company profile (legal identity for official documents — PO PDF letterhead etc.) ---
  // Pure reference data, surfaced via getCompanyProfile(). Distinct from the display brand above
  // (brandName) and from the app logo (logoUrl, which stays the single logo source of truth).
  companyLegalName    String?
  companyRegNumber    String?
  vatNumber           String?
  companyAddressLine1 String?
  companyAddressLine2 String?
  companyCity         String?
  companyCounty       String?
  companyPostcode     String?
  // Editable; defaults to "United Kingdom" at READ-time (never hardcoded), so future
  // international expansion only needs an edit here.
  companyCountry      String?
  companyPhone        String?
  companyEmail        String?
  websiteUrl          String?

  // --- Regional formatting (surfaced via getRegionalSettings(); defaults applied at read-time) ---
  timezone   String? // IANA tz; default "Europe/London"
  dateFormat String? // "DD/MM/YYYY" (default) | "MM/DD/YYYY" | "YYYY-MM-DD"
  timeFormat String? // "24h" (default) | "12h"

  // --- Engineer-to-engineer transfer ---
  // When true, every engineer-to-engineer transfer requires the receiving engineer to capture a
  // signature acknowledging receipt. Default (null/false) = optional.
  engineerTransferRequireSignature Boolean @default(false)

  // --- Goods management ---
  // After how many days stock still held by an engineer counts as OVERDUE. Drives the Goods
  // Management → Overdue list and the Inventory Hub's "N overdue" figure, so both move together.
  // Nullable with the default applied at READ time (getOverdueAfterDays), matching how timezone /
  // dateFormat are modelled — a fresh install and an admin who clears the field behave identically,
  // and the fallback lives in code rather than being frozen into every existing row.
  // 14 days suits a same-week install job; a business running month-long projects will want more.
  overdueAfterDays Int?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A role a user can be assigned. Seeded with the Senthra domain roles.
// `permissions` holds the delegatable permission keys the role grants
// ("*" = full access); the super-admin configures them.
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // stable machine key, e.g. "field_engineer"
  name        String // display name, e.g. "Field Engineer"
  description String?
  isSystem    Boolean  @default(false) // seeded role → cannot be deleted
  permissions String[] @default([]) // RESERVED for future RBAC (empty for now)
  // Field-operations capability: members of this role may HOLD field stock (the
  // Goods Out dispatch recipient + future Van Inventory / Engineer Usage / Returns).
  // NULLABLE on purpose: this field was ADDED to an existing collection, and Prisma+MongoDB
  // throws reading a doc that LACKS a non-optional field (same reason CustomerStockRequest
  // keeps its new fields nullable). Absent/null is treated as "can't hold stock" everywhere,
  // and @default(false) stamps new rows; the seed grants it to field-operations roles.
  canHoldStock Boolean? @default(false)
  // Warehouse-scoping capability: members of this role may ONLY access the warehouses they are
  // explicitly assigned (UserWarehouseAssignment). Drives the principal's assignedWarehouseIds and
  // every warehouse-bound access check. NULLABLE for the same added-to-existing-collection reason as
  // canHoldStock; absent/null = unrestricted. The seed grants it to WAREHOUSE_SCOPED_ROLE_KEYS.
  isWarehouseScoped Boolean? @default(false)
  sortOrder   Int      @default(0)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // auto slug from name: "Optical" -> "optical"
  name        String // display name exactly as typed
  // Lowercased `name`, kept in sync by the repository on every write. The @unique
  // index here is what actually enforces case-insensitive name uniqueness at the DB
  // (the `key` slug can legitimately collide for punctuation-only-distinct names, so
  // it can't carry this guard); the application pre-check is just for a friendly message.
  nameLower   String   @unique
  description String?
  status      String   @default("active") // active | inactive
  sortOrder   Int      @default(0)
  customerStockEntries CustomerStockEntry[] @relation("CustomerStockEntryCategory")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Warehouse Type master-data (e.g. "Main Depot", "Engineer Van"). The operational
// classification a warehouse belongs to — managed under Settings exactly like the
// stock Category master. A warehouse references one type by id (typeId). Mirrors the
// Category model: slug `key`, case-insensitive `nameLower` guard, status + sortOrder.
model WarehouseType {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  key         String      @unique // auto slug from name: "Main Depot" -> "main_depot"
  name        String // display name exactly as typed
  nameLower   String      @unique // case-insensitive uniqueness (enforced at the DB)
  description String?
  status      String      @default("active") // active | inactive
  sortOrder   Int         @default(0)
  warehouses  Warehouse[] // back-relation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// A physical stock location (e.g. "Leeds Depot") — the master record every future
// inventory movement (Goods In/Out, Stock Transfer, Engineer Dispatch, Rental) is
// scoped against. This is MASTER-DATA ONLY: stock is never stored on the warehouse;
// balances derive from an inventory ledger that references `warehouseId`, added in a
// later phase. Codes are Counter-allocated (WH-0001), same mechanism as employeeId /
// customerCode. Geolocation is derived server-side from the postcode (never typed).
model Warehouse {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  code        String  @unique // auto-allocated, e.g. WH-0001
  name        String
  description String?

  // Operational classification → the WarehouseType master (single source of truth).
  typeId        String?        @db.ObjectId
  warehouseType WarehouseType? @relation(fields: [typeId], references: [id])

  // The default destination for future Goods In. At most one warehouse is the default
  // at a time — the service unsets the previous default when a new one is chosen.
  isDefault Boolean @default(false)

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? // defaults to "United Kingdom" in the UI

  // Geolocation — derived from the postcode (postcodes.io) on the server. Hidden,
  // read-only system fields; never hand-entered.
  latitude  Float?
  longitude Float?

  // Contact.
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  // Operational metadata — display-only for now (no scheduling / inventory logic).
  operatingHours String? // free-text, e.g. "Mon–Fri 08:00–18:00"
  timezone       String? @default("Europe/London")
  notes          String?

  // NOTE: there is deliberately NO manager column. A warehouse's managers are DERIVED from
  // `userAssignments` below (the "Assigned warehouses" an admin sets on a user under Users &
  // Roles, for warehouse-scoped roles). One source of truth: the thing that grants access IS
  // the thing that names the manager. A separate manager field on the warehouse duplicated it
  // and granted nothing, so it was removed.

  status String @default("active") // active | inactive

  // Purchase requests + orders delivering to this warehouse (back-relations; no DB column).
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  // Goods In + inventory at this warehouse (back-relations; no DB column).
  goodsReceipts         GoodsReceipt[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  // Stock transfers leaving / arriving at this warehouse (back-relations; no DB column).
  stockTransfersFrom StockTransfer[] @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[] @relation("StockTransferTo")
  // Manual stock adjustments (existing/opening stock) added at this warehouse (back-relation).
  stockAdjustments StockAdjustment[]
  // Customer stock assignments destined for this warehouse (back-relation; no DB column).
  customerStockAssignments CustomerStockWarehouseAssignment[]
  // Received customer stock physically at this warehouse (back-relation; no DB column).
  customerStockEntries     CustomerStockEntry[]
  // Users explicitly assigned to this warehouse (warehouse-scoped roles) (back-relation; no DB column).
  userAssignments          UserWarehouseAssignment[]
  // Job kit lines collected from this warehouse (back-relation; no DB column).
  jobKitLines              JobKitLine[]
  // Goods Management (back-relations; no DB column).
  jobStockMovements     JobStockMovement[]
  damagedStockBalances  DamagedStockBalance[]
  // Non-job van stock requests fulfilled at this warehouse (back-relation; no DB column).
  vanStockRequests      VanStockRequest[]
  // Van stock request lines ISSUED from this warehouse (back-relation; no DB column).
  vanStockRequestLines  VanStockRequestLine[]

  deletedAt DateTime? // soft delete — excluded from listings; history stays intact

  createdBy String? // staff email that created the warehouse
  updatedBy String? // staff email that last updated it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([typeId])
}

// Supplier Type master-data (e.g. "Manufacturer", "Distributor"). The classification a
// supplier belongs to — managed under Settings exactly like the Warehouse Type / stock
// Category masters. A supplier references one type by id (typeId). Mirrors the Category
// model: slug `key`, case-insensitive `nameLower` guard, status + sortOrder.
model SupplierType {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  key         String     @unique // auto slug from name: "Service Provider" -> "service_provider"
  name        String // display name exactly as typed
  nameLower   String     @unique // case-insensitive uniqueness (enforced at the DB)
  description String?
  status      String     @default("active") // active | inactive
  sortOrder   Int        @default(0)
  suppliers   Supplier[] // back-relation
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// A supplier — the organisation inventory is procured from (e.g. "Corning Ltd"). This is
// MASTER-DATA ONLY: no procurement, purchase-order, goods-in or pricing logic lives here;
// those modules reference `supplierId` later. Codes are Counter-allocated (SUP-0001), same
// mechanism as warehouseCode / customerCode / employeeId. No geolocation (suppliers aren't
// geocoded). Soft-deleted rows (deletedAt set) are excluded from normal reads.
model Supplier {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  code        String  @unique // auto-allocated, e.g. SUP-0001
  name        String
  legalName   String? // legal / registered business name (distinct from trading name)
  description String?

  // Classification → the SupplierType master (single source of truth).
  typeId       String?       @db.ObjectId
  supplierType SupplierType? @relation(fields: [typeId], references: [id])

  status String @default("active") // active | inactive

  // Primary contact (all optional).
  contactPerson   String?
  contactJobTitle String?
  contactEmail    String?
  contactPhone    String?

  // Business information (all optional).
  companyRegistrationNumber String?
  vatNumber                 String?
  website                   String?

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? // defaults to "United Kingdom" in the UI

  // Payment.
  paymentTerms       String? // Prepaid | 7 Days | … | 90 Days | Custom
  customPaymentTerms String? // free-text, used only when paymentTerms = "Custom"
  currency           String? @default("GBP") // GBP | EUR

  // Operational.
  leadTimeDays Int? // typical lead time in days (0–365)
  notes        String?

  // IRM items this supplier can supply (junction back-relation; no DB column).
  irmLinks IrmItemSupplier[]
  // Purchase requests + orders raised against this supplier (back-relations; no DB column).
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  // Field jobs using this supplier as external installer (back-relation; no DB column).
  jobs           Job[]

  deletedAt DateTime? // soft delete — excluded from listings; history stays intact

  createdBy String? // staff email that created the supplier
  updatedBy String? // staff email that last updated it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([typeId])
}

// ── IRM (company-owned internal stock) Catalogue — MASTER DATA ONLY ───────────────────
// Completely separate from customer stock entries. Defines items
// that future procurement/inventory modules (Purchase Orders, Goods In, Warehouse
// Inventory, Stock Transfer, Goods Out, Rental) reference. No stock movement, no balances,
// no physical locations stored here. Codes are Counter-allocated (IRM-0001). Cost is stored
// in integer pence (never a float). IRM and customer assets never mix.

// IRM Type master (e.g. "Consumable", "Asset") — managed under Settings, mirrors the
// Supplier Type / Warehouse Type / Category masters.
model IrmType {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  key         String    @unique
  name        String
  nameLower   String    @unique
  description String?
  status      String    @default("active") // active | inactive
  sortOrder   Int       @default(0)
  items       IrmItem[] // back-relation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// IRM Category master — the COMPANY-domain classification taxonomy. DELIBERATELY separate
// from the customer-domain `Category` master to avoid reporting / ownership coupling.
model IrmCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  key         String    @unique
  name        String
  nameLower   String    @unique
  description String?
  status      String    @default("active") // active | inactive
  sortOrder   Int       @default(0)
  items       IrmItem[] // back-relation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A company-owned internal stock item (e.g. "CAT6 Cable"). MASTER DATA ONLY.
model IrmItem {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  code         String  @unique // auto-allocated, e.g. IRM-0001
  name         String
  description  String?
  brand        String?
  manufacturer String?
  mpn          String? // manufacturer part number

  // Classification (company domain).
  typeId        String?      @db.ObjectId
  irmType       IrmType?     @relation(fields: [typeId], references: [id])
  irmCategoryId String?      @db.ObjectId
  irmCategory   IrmCategory? @relation(fields: [irmCategoryId], references: [id])

  status String @default("active") // active | inactive

  // Identification. `sku` is MANDATORY (irm.validation.ts requires it on create and update, and the
  // service generates one from the name + category when a caller sends none) and GLOBALLY unique
  // FOREVER — never reused, even after soft-delete. Enforced at the DB by a PARTIAL unique index on
  // `skuLower` (created in the seed step via irmRepo.ensureSkuUniqueIndex) PLUS an app-level
  // pre-check. Do NOT add `@unique` here: Prisma would create a non-sparse index that rejects a
  // second null (prisma#23870). Do NOT make it required either — on MongoDB that enforces nothing
  // and only turns any row predating the rule into a read crash. The partial index covers string
  // skuLower values, which is every row a create can produce.
  sku      String?
  skuLower String?
  // Free-text / manufacturer barcode (e.g. an EAN). UNIQUE across all rows, enforced by a PARTIAL
  // unique index (irmRepo.ensureBarcodeUniqueIndex) for the same reason as skuLower above — do NOT
  // add `@unique`. Uniqueness is load-bearing: findActiveByCodeOrBarcode resolves a scan against
  // this field with findFirst, so a duplicate would silently return the wrong item. The index also
  // keeps that $or off a collection scan (Mongo needs every $or arm indexed to use index union).
  barcode  String?
  qrCode   String?
  // Rendered Code128 barcode image (base64 PNG data URI) — generated on demand from the
  // item's own `code` (e.g. IRM-0004), printable as a label. Regenerating just re-renders it.
  // Free-text `barcode`/`qrCode` above are left untouched (manual/manufacturer values).
  barcodeDataUri String?

  // Suppliers — at least one, exactly one primary (junction; enforced in the service).
  suppliers IrmItemSupplier[]

  // Unit of measure.
  baseUnit        String? // e.g. "Each", "Metre"
  // Units per pack. LOAD-BEARING: the reorder engine rounds a suggested quantity UP to whole packs
  // (see inventory/reorder.ts), so a 412-metre need on a 305m-box item is ordered as 2 boxes. Drop it
  // and the rounding silently stops — purchase requests keep generating, just with quantities no
  // supplier will accept.
  packSize        Int?
  // RETIRED from the app: no reader, no writer, and no form field — it was captured and then never
  // used by any calculation. Kept DECLARED so the values stay readable through Prisma (on MongoDB,
  // dropping a field from the schema doesn't delete anything — `db push` only manages indexes — it
  // just makes the data invisible to the client, which is worse than leaving it in view). Do not
  // re-surface it in the UI without a consumer to justify it.
  conversionRatio Float?

  // Stock policies (planning thresholds — ADVISORY; never live stock).
  //
  // THREE live thresholds, and they stack: criticalLevel <= reorderLevel <= maximumStock.
  //   reorderLevel  — WHEN to buy. The trigger; "minimum stock" in warehouse speech.
  //   maximumStock  — HOW FAR to top up. The reorder target; null degrades to reorderLevel, which
  //                   only restores the trigger line and re-fires immediately (see reorder.ts).
  //   criticalLevel — HOW URGENT. Flags the row red; never changes the quantity ordered.
  reorderLevel    Int?
  maximumStock    Int?
  criticalLevel   Int?
  // RETIRED — no reader, no writer, no form field. `minimumStock` and `safetyStock` were captured and
  // used by nothing, and `minimumStock` was the worse of the two: it is the familiar phrase, so people
  // filled it in believing it set the trigger while `reorderLevel` silently did. `reorderQuantity` was
  // a second way to express the target (reorderLevel + qty) that maximumStock always beat when both
  // were set, so the number typed was discarded without a word.
  //
  // Kept DECLARED for the same reason as conversionRatio above — on MongoDB, removing a field from
  // the schema deletes nothing, it only hides the stored values from Prisma. `reorderQuantity`
  // especially: it is the evidence of what an item's old top-up target was, and
  // scripts/backfill-reorder-target.ts carries it over to `maximumStock`. Do not re-surface any of
  // them in the UI without a consumer to justify it.
  minimumStock    Int?
  reorderQuantity Int?
  safetyStock     Int?

  // Cost (internal only — never exposed to customers). Pence to avoid float drift.
  standardCostPence Int?
  currency          String? @default("GBP") // GBP | EUR
  vatRatePercent    Float?  @default(20) // UK standard rate default

  // Tracking flags.
  //
  // No form field sets these — the item form's toggles were removed deliberately, so every item sits
  // at the defaults. `trackInventory` is read widely; the serial/batch pair is a FUTURE seam, and the
  // goods scan already refuses an item carrying either ("can't be moved here yet") so the feature
  // cannot be half-enabled by data alone. Keep them.
  trackInventory     Boolean @default(true)
  trackSerialNumbers Boolean @default(false)
  trackBatchNumbers  Boolean @default(false)
  // RETIRED — unlike its neighbours this one has NO consumer anywhere: nothing reads it, no rule
  // branches on it, and every row is false. Column kept so existing rows aren't rewritten. Do not
  // re-surface it without something that actually honours it.
  allowNegativeStock Boolean @default(false)

  // Operations.
  notes String?

  // Purchase-request + purchase-order lines referencing this item (back-relations; no DB column).
  purchaseRequestLines PurchaseRequestItem[]
  purchaseOrderLines   PurchaseOrderItem[]
  // Goods In lines + inventory for this item (back-relations; no DB column).
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  // Stock transfers of this item between warehouses (back-relation; no DB column).
  stockTransfers StockTransfer[]
  // Engineer-held stock for this item (back-relation; no DB column).
  engineerStockBalances    EngineerStockBalance[]
  engineerStockTransactions EngineerStockTransaction[]
  // Job kit lines drawing this IRM item (back-relation; no DB column).
  jobKitLines              JobKitLine[]
  // Goods Management (back-relations; no DB column).
  jobStockMovementLines JobStockMovementLine[]
  damagedStockBalances  DamagedStockBalance[]

  deletedAt DateTime? // soft delete — excluded from listings; history stays intact

  createdBy String? // staff email that created the item
  updatedBy String? // staff email that last updated it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([typeId])
  @@index([irmCategoryId])
}

// Junction: which suppliers can provide an IRM item, with ranking + per-supplier detail.
// Replaces a scalar array so future Purchase Orders can do preferred-supplier / ranking /
// price-comparison / lead-time work. Suppliers are OPTIONAL — an item may have no rows at all —
// and at most one row per item has isPrimary = true.
model IrmItemSupplier {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  irmItemId    String   @db.ObjectId
  irmItem      IrmItem  @relation(fields: [irmItemId], references: [id])
  supplierId   String   @db.ObjectId
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  isPrimary    Boolean  @default(false)
  priority     Int      @default(0)
  supplierSku  String?
  leadTimeDays Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([irmItemId, supplierId])
  @@index([supplierId])
}

// ── Purchase Requests (PRF) — the pre-PO procurement document ────────────────────────
// Captures the supplier quotation (structured fields + file attachments) and the internal
// Purchase Request Form, routes it through Finance review, and converts — exactly once —
// into a Purchase Order. Codes are Counter-allocated (PRF-0001). Money is integer GBP
// pence. Status is a forward-only machine enforced in the service: draft → submitted →
// approved → converted, with reject/reopen back to draft and cancel from any pre-converted
// state. EDITABLE ONLY IN `draft`; a `converted` PRF is READ-ONLY FOREVER.
model PurchaseRequest {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // auto-allocated, e.g. PRF-0001 — never freed

  // Supplier (resolved live; name snapshotted for list/history).
  supplierId   String   @db.ObjectId
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierName String? // snapshot at create

  // Delivery destination warehouse — one warehouse per PRF (matches the one-per-PO rule).
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Project reference — an optional Job link plus a free-text fallback.
  jobId      String? @db.ObjectId
  job        Job?    @relation(fields: [jobId], references: [id])
  projectRef String?

  // Provenance — set by future request modules (e.g. a job-kit request raising a PRF).
  // System-owned; never accepted from the client API.
  sourceType String?
  sourceId   String? @db.ObjectId

  status String @default("draft") // draft|submitted|approved|converted|cancelled

  // Supplier quotation (structured) — the quote file(s) go in attachments.
  quoteReference  String?
  quoteDate       DateTime?
  quoteValidUntil DateTime?

  // When the requester needs the goods on site. Becomes the generated PO's expectedDeliveryDate
  // at conversion — the ONLY source for it (never derived from the supplier's lead time, which
  // would look like a commitment nobody made). REQUIRED on create; nullable only because PRFs
  // raised before this field existed have none — convert refuses those until a date is added.
  requiredByDate DateTime?

  justification String? // business justification (the client's PRF field)
  notes         String?

  // Commercial terms captured from the quote — carried onto the generated PO at conversion.
  deliveryTerms String? // Incoterm code, e.g. "DDP" | "EXW"
  paymentTerms  String? // agreed payment term (free text, e.g. "30 Days")

  currency String @default("GBP") // GBP only for now

  // Financial roll-ups — SYSTEM-CALCULATED from the lines (integer pence). The "Estimated Cost".
  subtotalPence   Int @default(0)
  vatPence        Int @default(0)
  grandTotalPence Int @default(0)

  // Workflow — actor email snapshots + timestamps.
  createdBy       String? // "Requested By"
  submittedBy     String?
  submittedAt     DateTime?
  approvedBy      String? // the Finance reviewer
  approvedAt      DateTime?
  rejectionReason String? // last reject (submitted → draft)
  reopenReason    String? // last revision reopen (approved → draft)
  cancelledAt     DateTime?
  cancelReason    String?
  convertedAt     DateTime?
  updatedBy       String?

  // Set when this PRF was duplicated from a converted one (price-revision chain).
  revisionOfId String? @db.ObjectId

  deletedAt DateTime? // soft delete — DRAFT only; PRF numbers are never freed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items       PurchaseRequestItem[]
  attachments PurchaseRequestAttachment[]
  // The PO generated from this PRF (back-relation; AT MOST ONE — enforced by the convert
  // transaction + status machine, not @unique: Prisma+Mongo would build a NON-SPARSE unique
  // index on the PO side that rejects a second null purchaseRequestId (prisma#23870)).
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([jobId])
}

// A line on a purchase request. Snapshots the IRM item's name/sku/unit at add-time (exact
// parity with PurchaseOrderItem) so a later IRM rename never rewrites a reviewed request.
// Prices come from the supplier quotation.
model PurchaseRequestItem {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  purchaseRequestId String          @db.ObjectId
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  irmItemId         String          @db.ObjectId
  irmItem           IrmItem         @relation(fields: [irmItemId], references: [id])

  // Snapshots (denormalised for self-contained, historically-accurate lines).
  itemName String
  sku      String?
  baseUnit String?

  quantity       Int
  unitPricePence Int // the quoted unit price
  vatRate        Float   @default(0)
  lineTotalPence Int     @default(0) // system-calculated: quantity * unitPricePence (ex-VAT)
  notes          String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseRequestId, irmItemId])
  @@index([purchaseRequestId])
  @@index([irmItemId])
}

// A file attached to a purchase request — the supplier quotation / supporting docs.
// Uploaded to Cloudinary (raw for PDF/DOCX, image for PNG/JPG); rows are copied onto the
// generated PO at conversion (same URLs) so the PO carries its supporting evidence.
model PurchaseRequestAttachment {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  purchaseRequestId String          @db.ObjectId
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  label             String?
  fileName          String
  fileType          String // pdf | docx | png | jpg
  fileSizeBytes     Int
  url               String
  // Cloudinary asset identity. NULLABLE on purpose: rows written before identity was persisted
  // have neither, and a null means "we cannot safely name this asset", which makes the deletion
  // path skip it. Never infer these from `url` at runtime — see attachment.repository.ts.
  //
  // The identity is the PAIR. `publicId` alone is not unique: the same id can exist once as an
  // `image` and once as a `raw` asset, and Cloudinary's destroy API needs both to address one.
  publicId          String?
  resourceType      String? // "image" | "raw"
  uploadedBy        String?
  createdAt         DateTime @default(now())

  @@index([purchaseRequestId])
  // Reference counting before a Cloudinary delete. One asset can be referenced by more than one
  // row (PRF → PO conversion copies the identity), so the delete path counts across all three
  // attachment tables and destroys nothing while a reference survives.
  @@index([resourceType, publicId])
}

// ── Purchase Orders — PROCUREMENT WORKFLOW ONLY ──────────────────────────────────────
// Raise an order against a Supplier for IRM Catalogue items, route it through approval,
// issue it to the supplier, track status until it is READY FOR GOODS IN. No stock movement,
// no balances, no receiving here — `receivedQuantity` stays 0 and the received statuses are
// driven LATER by Goods In via a guarded seam. Codes are Counter-allocated (PO-0001). Money
// is integer GBP pence. Status is a forward-only machine enforced in the service. EDITABLE
// ONLY IN `draft`: once submitted, the header, supplier, warehouse, quantities and prices
// are locked; only Reject → Draft reopens editing.
model PurchaseOrder {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // auto-allocated, e.g. PO-0001

  // Supplier (read-only section, resolved live; name snapshotted for list/history).
  supplierId   String   @db.ObjectId
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierName String? // snapshot at create

  // Delivery destination warehouse (defaults to the company default warehouse in the UI).
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Source PRF when this PO was generated from an approved Purchase Request. At most one PO
  // per PRF — enforced by the convert transaction + PRF status machine (NOT @unique here:
  // Prisma+Mongo builds a non-sparse unique index that would reject a second null, prisma#23870).
  purchaseRequestId String?          @db.ObjectId
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])

  // Project reference — an optional Job link plus a free-text fallback (carried from the PRF,
  // or set directly on a standalone PO).
  jobId      String? @db.ObjectId
  job        Job?    @relation(fields: [jobId], references: [id])
  projectRef String?

  status   String @default("draft") // draft|pending_approval|approved|pm_review|sent|supplier_accepted|partially_received|fully_received|closed|cancelled
  priority String @default("normal") // low | normal | high | urgent

  // PM routing (approved → pm_review → sent). pmUserId is a loose socket (no relation —
  // mirrors Job.createdByUserId); name/email are snapshots so the record survives renames.
  pmUserId     String?   @db.ObjectId
  pmName       String?
  pmEmail      String?
  pmAssignedAt DateTime?
  pmAssignedBy String?

  // Supplier acceptance — recorded manually by staff when the supplier confirms. An EVENT, not a
  // workflow gate: goods routinely arrive before the paperwork, so it is recordable at any
  // non-terminal issued status (sent | supplier_accepted | partially_received | fully_received)
  // and only ADVANCES sent → supplier_accepted; on the others the receipt status stays the truth.
  // confirmedDeliveryDate is required at capture and updatable later; EVERY change is audited
  // with {previousDate, newDate, reason} metadata (the audit ledger IS the revision history).
  supplierAcceptedAt    DateTime? // when acceptance was recorded
  supplierAcceptedBy    String?   // staff email snapshot — who recorded it
  supplierAckReference  String?   // the supplier's own order/confirmation reference
  confirmedDeliveryDate DateTime?
  supplierAcceptNotes   String?

  referenceNumber      String?
  description          String?
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?

  currency String @default("GBP") // GBP only for now

  // Financial roll-ups — SYSTEM-CALCULATED from the lines (integer pence). Never user-set.
  subtotalPence   Int @default(0)
  vatPence        Int @default(0)
  grandTotalPence Int @default(0)

  // Delivery.
  deliveryAddress      String? // optional override; defaults to the warehouse address in the UI
  deliveryInstructions String? // practical note (access hours, contact, loading bay) — NOT a term
  deliveryTerms        String? // Incoterm code, e.g. "DDP" | "EXW" (UK Incoterms 2020 subset)

  // Commercial terms — the AGREED payment term for THIS order (free text, e.g. "30 Days").
  // Pre-fills from the supplier's default in the UI but is editable per PO, since a quote can
  // agree a different term than the supplier's standing default.
  paymentTerms String?

  // Notes.
  internalNotes String? // never leaves the company
  supplierNotes String? // appears on the issued PO

  // Approval workflow — actor email snapshots + timestamps.
  createdBy       String?
  submittedBy     String?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  sentBy          String? // issuer email snapshot — the signer printed on the issued PO document
  closedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  rejectionReason String?
  updatedBy       String?

  deletedAt DateTime? // soft delete — DRAFT only; PO numbers are never freed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         PurchaseOrderItem[]
  attachments   PurchaseOrderAttachment[]
  goodsReceipts GoodsReceipt[] // Goods In receipts against this PO (back-relation; no DB column)

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseRequestId])
  @@index([jobId])
  @@index([pmUserId])
}

// A line on a purchase order. Snapshots the IRM item's name/sku/unit at add-time so a later
// IRM rename never rewrites an issued order. `receivedQuantity` is the GOODS IN seam (0 here).
model PurchaseOrderItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String        @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  irmItemId       String        @db.ObjectId
  irmItem         IrmItem       @relation(fields: [irmItemId], references: [id])

  // Snapshots (denormalised for self-contained, historically-accurate lines).
  itemName String
  sku      String?
  baseUnit String?

  quantity         Int
  unitPricePence   Int
  vatRate          Float   @default(0)
  lineTotalPence   Int     @default(0) // system-calculated: quantity * unitPricePence (ex-VAT)
  receivedQuantity Int     @default(0) // FUTURE Goods In writes this; 0 in this module
  notes            String?
  sortOrder        Int     @default(0)

  // Goods In lines receiving against this PO line (back-relation; no DB column).
  goodsReceiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseOrderId, irmItemId])
  @@index([purchaseOrderId])
  @@index([irmItemId])
}

// A file attached to a purchase order (supplier quote/invoice/supporting doc). Uploaded to
// Cloudinary (raw for PDF/DOCX, image for PNG/JPG).
model PurchaseOrderAttachment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String        @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  label           String?
  fileName        String
  fileType        String // pdf | docx | png | jpg
  fileSizeBytes   Int
  url             String
  // Same pair as PurchaseRequestAttachment, and on a converted PRF's attachments it holds the
  // SAME values — the conversion copies the identity rather than re-uploading the file. That is
  // why removing a PO attachment must not assume it owns the asset.
  publicId        String?
  resourceType    String? // "image" | "raw"
  uploadedBy      String?
  createdAt       DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([resourceType, publicId])
}

// ── GOODS IN (GRN — Goods Receipt Note) ───────────────────────────────────────────────
// Receives physical goods against a SENT / partially-received Purchase Order, captures
// serials / batches / damage, increases warehouse inventory, and advances the PO received
// status. The FIRST module to mutate inventory. Codes Counter-allocated (GRN-0001).
// Forward-only status draft → completed → cancelled; inventory is written ONCE, atomically,
// at Completed. Soft-deleted rows (deletedAt set) are excluded from normal reads.
model GoodsReceipt {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // auto-allocated, e.g. GRN-0001

  // Source purchase order — the only way goods enter. poCode + supplier snapshotted.
  purchaseOrderId String        @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  poCode          String? // snapshot at create

  // Supplier — denormalised id + name snapshot (resolved live via the PO; no direct FK,
  // so supplier deletion stays guarded by the PO that references it).
  supplierId   String? @db.ObjectId
  supplierName String?

  // Destination warehouse — taken from the PO, immutable (user can't change it).
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status String @default("draft") // draft | completed | cancelled

  receivedDate        DateTime
  referenceNumber     String?
  carrier             String?
  deliveryNoteNumber  String?
  vehicleRegistration String?
  description         String?

  // Quality summary (manual flag; per-line damagedQuantity carries the granular detail).
  qualityStatus String  @default("passed") // passed | partial | failed
  qualityNotes  String?

  internalNotes String?

  createdBy    String?
  completedBy  String?
  completedAt  DateTime?
  cancelledBy  String?
  cancelledAt  DateTime?
  cancelReason String?
  updatedBy    String?

  deletedAt DateTime? // soft delete — DRAFT only; GRN numbers are never freed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       GoodsReceiptItem[]
  attachments GoodsReceiptAttachment[]

  @@index([status])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([supplierId])
}

// A received line. Receives against ONE PO line; snapshots item name/sku/unit + the ordered
// and previously-received quantities at draft time. acceptedQuantity (= received − damaged)
// is the GOOD stock that enters inventory; damaged units are recorded but never added.
model GoodsReceiptItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  goodsReceiptId String       @db.ObjectId
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])

  purchaseOrderItemId String            @db.ObjectId
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  irmItemId           String            @db.ObjectId
  irmItem             IrmItem           @relation(fields: [irmItemId], references: [id])

  // Snapshots (denormalised for self-contained, historically-accurate lines).
  itemName String
  sku      String?
  baseUnit String?

  orderedQuantity    Int // snapshot of the PO line quantity at draft
  previouslyReceived Int @default(0) // snapshot of the PO line receivedQuantity at draft
  receivedQuantity   Int // physically received in THIS GRN (incl damaged)
  damagedQuantity    Int @default(0)
  acceptedQuantity   Int // computed = received − damaged (good stock → inventory)
  notes              String?
  sortOrder          Int     @default(0)

  serials GoodsReceiptSerial[]
  batches GoodsReceiptBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([goodsReceiptId])
  @@index([irmItemId])
}

// One serial per accepted unit (only when the IRM item tracks serial numbers).
model GoodsReceiptSerial {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  goodsReceiptItemId String           @db.ObjectId
  goodsReceiptItem   GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  irmItemId          String           @db.ObjectId // denormalised for per-item uniqueness checks
  serialNumber       String
  serialLower        String
  createdAt          DateTime @default(now())

  @@index([goodsReceiptItemId])
  // DB-level backstop: a serial = one physical unit, unique per IRM item across all receipts.
  // The app-level check (findSerialConflicts) gives friendly errors; this prevents a concurrent
  // race from inserting the same serial twice. A P2002 here is mapped to a 409 in the repository.
  @@unique([irmItemId, serialLower])
}

// A batch / lot received (only when the IRM item tracks batch numbers). Σ quantity == accepted.
model GoodsReceiptBatch {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  goodsReceiptItemId String           @db.ObjectId
  goodsReceiptItem   GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  batchNumber        String
  expiryDate         DateTime?
  quantity           Int
  createdAt          DateTime @default(now())

  @@index([goodsReceiptItemId])
}

// A file attached to a goods receipt (delivery note / invoice / packing slip / photo).
// Mirrors PurchaseOrderAttachment (Cloudinary; pdf/docx/png/jpg).
model GoodsReceiptAttachment {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  goodsReceiptId String       @db.ObjectId
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  label          String?
  fileName       String
  fileType       String // pdf | docx | png | jpg
  fileSizeBytes  Int
  url            String
  // GRN attachments are always uploaded fresh (nothing copies them), so in practice these are
  // unique to the row. The delete path still counts across every attachment table rather than
  // relying on that — the next module to copy an attachment would otherwise inherit a silent bug.
  publicId       String?
  resourceType   String? // "image" | "raw"
  uploadedBy     String?
  createdAt      DateTime @default(now())

  @@index([goodsReceiptId])
  @@index([resourceType, publicId])
}

// ── INVENTORY PRIMITIVES ───────────────────────────────────────────────────────────────
// Introduced by Goods In (the first module to mutate stock); the future Warehouse Inventory
// module OWNS and extends them. Goods In only WRITES inbound rows.

// Current on-hand per IRM item × warehouse. A maintained running total, reconstructable from
// the InventoryTransaction ledger. NO soft-delete (balances are maintained, not deleted).
model InventoryBalance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  irmItemId   String    @db.ObjectId
  irmItem     IrmItem   @relation(fields: [irmItemId], references: [id])
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantityOnHand   Int @default(0)
  quantityReserved Int @default(0) // FUTURE (Goods Out / allocation); 0 now

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([irmItemId, warehouseId])
  @@index([warehouseId])
}

// Immutable, append-only stock ledger — every inventory change is exactly one row. type /
// sourceType describe the movement; balanceAfter snapshots on-hand post-apply. NEVER updated
// or deleted.
model InventoryTransaction {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  irmItemId   String    @db.ObjectId
  irmItem     IrmItem   @relation(fields: [irmItemId], references: [id])
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantityDelta Int // + inbound (Goods In / manual_add) / − outbound (transfer/goods_out)
  type          String // goods_in | manual_add | transfer_in | transfer_out | goods_out (future: return)
  sourceType    String // goods_receipt | stock_transfer | stock_adjustment
  sourceId      String  @db.ObjectId // id of the source record (GoodsReceipt / StockTransfer / StockAdjustment)
  sourceCode    String? // snapshot, e.g. GRN-0001 / TRF-0001 / ADJ-0001
  balanceAfter  Int // on-hand snapshot after applying this row
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([irmItemId, warehouseId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  // Serves the warehouse's Transactions tab: equality on warehouseId, then the keyset sort on
  // createdAt (findInventoryTxnPage). Neither existing index covers it — `[irmItemId, warehouseId]`
  // has the wrong prefix for a warehouseId-only filter, so the planner falls back to `[createdAt]`
  // and walks the whole ledger newest-first discarding every row belonging to another warehouse.
  // This ledger is append-only, so that scan only ever gets longer.
  @@index([warehouseId, createdAt])
}

// A completed warehouse → warehouse stock movement (TRF-0001). The Warehouse Inventory module's
// only write: applied atomically (decrement source + increment destination + two immutable
// InventoryTransaction ledger rows) in one transaction. Item/warehouse names + codes are snapshotted
// so the record reads correctly even if the masters are later renamed. Soft-delete only (no delete
// endpoint). `deletedAt` is written EXPLICITLY on create (Prisma+Mongo `{deletedAt:null}` reads don't
// match an absent field).
model StockTransfer {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  code    String  @unique // auto-allocated, e.g. TRF-0001
  irmItemId String  @db.ObjectId
  irmItem   IrmItem @relation(fields: [irmItemId], references: [id])
  itemName  String // snapshot
  sku       String? // snapshot

  fromWarehouseId   String    @db.ObjectId
  fromWarehouse     Warehouse @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseName String // snapshot
  fromWarehouseCode String? // snapshot

  toWarehouseId   String    @db.ObjectId
  toWarehouse     Warehouse @relation("StockTransferTo", fields: [toWarehouseId], references: [id])
  toWarehouseName String // snapshot
  toWarehouseCode String? // snapshot

  quantity     Int
  movementDate DateTime
  status       String  @default("completed") // completed (only state today)

  referenceNumber String?
  description     String?
  internalNotes   String?

  createdBy String? // staff email that performed the transfer
  deletedAt DateTime? // soft delete — no delete endpoint; history stays intact

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([irmItemId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movementDate])
}

// A lightweight header for a MANUAL stock addition (existing / opening / legacy stock added
// straight into a warehouse, NOT received via Goods In). Each add allocates an ADJ-#### code and
// is applied atomically: upsert the InventoryBalance + append ONE "manual_add" InventoryTransaction
// whose sourceType="stock_adjustment" and sourceId=this row's id (loose coupling, mirroring how the
// ledger references goods_receipt). The item + quantity live on the ledger row, so this header stays
// forward-compatible with multi-line adds later. Inbound-only in v1.
model StockAdjustment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique // auto-allocated, e.g. ADJ-0001
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  reason          String // opening_balance | legacy_stock | found | other
  movementDate    DateTime
  referenceNumber String?
  notes           String?

  createdBy String? // staff email that performed the add
  createdAt DateTime @default(now())

  @@index([warehouseId])
  @@index([createdAt])
}

// Engineer-held stock primitive — the engineer-side twin of InventoryBalance. The on-hand quantity an
// engineer currently holds for an IRM item. Job Pack issue increments it; returns / engineer-to-engineer
// transfers adjust it. Written via the shared engineer-stock repository.
model EngineerStockBalance {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  irmItemId  String  @db.ObjectId
  irmItem    IrmItem @relation(fields: [irmItemId], references: [id])
  engineerId String  @db.ObjectId
  engineer   User    @relation("EngineerStockOwner", fields: [engineerId], references: [id])

  quantityOnHand Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([irmItemId, engineerId])
  @@index([engineerId])
}

// Immutable, append-only engineer-stock ledger — the engineer-side twin of InventoryTransaction.
model EngineerStockTransaction {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  irmItemId  String  @db.ObjectId
  irmItem    IrmItem @relation(fields: [irmItemId], references: [id])
  engineerId String  @db.ObjectId
  engineer   User    @relation("EngineerStockTxnOwner", fields: [engineerId], references: [id])

  quantityDelta Int // + dispatch in (future: − usage/return, +/− transfer)
  type          String // goods_out (future: usage, return, transfer_in, transfer_out)
  sourceType    String // goods_out
  sourceId      String   @db.ObjectId
  sourceCode    String? // snapshot, e.g. GDN-0001
  balanceAfter  Int // engineer on-hand snapshot after applying this row
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([irmItemId, engineerId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

// ── Goods Management (job-scoped issue → work → return → reconcile) ─────────────────────────────
// A scan session that moves stock between a warehouse and the assigned engineer for a Job.
// direction: issue (WM scan-out) | return (WM scan-in) | consume (engineer declaration at Complete).
// Draft (editable) → posted (terminal; balances + ledgers written ONCE). Code GM-####.
model JobStockMovement {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // auto-allocated, e.g. GM-0001

  jobId String @db.ObjectId
  job   Job    @relation(fields: [jobId], references: [id])

  direction String // issue | return | consume

  engineerId    String @db.ObjectId
  engineer      User   @relation("JobStockMovementEngineer", fields: [engineerId], references: [id])
  engineerName  String // snapshot
  engineerEmail String? // snapshot

  warehouseId   String?    @db.ObjectId // null for consume (engineer-declared, no warehouse)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseName String? // snapshot
  warehouseCode String? // snapshot

  status      String @default("draft") // draft | posted
  notes       String?
  performedBy String? // actor email snapshot
  postedAt    DateTime?

  items JobStockMovementLine[]

  createdBy String?
  deletedAt DateTime? // soft delete — draft-only; history stays intact
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
  @@index([direction])
  @@index([status])
  @@index([warehouseId])
  @@index([engineerId])
}

model JobStockMovementLine {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  movementId String           @db.ObjectId
  movement   JobStockMovement @relation(fields: [movementId], references: [id])

  source    String // irm | customer
  irmItemId String?  @db.ObjectId
  irmItem   IrmItem? @relation(fields: [irmItemId], references: [id])
  customerStockEntryId String? @db.ObjectId // loose socket (no relation), mirroring JobKitLine

  itemName String // snapshot
  sku      String? // snapshot
  uom      String? // snapshot

  qty       Int
  condition String  @default("good") // good | damaged (only meaningful on returns)
  jobKitLineId String? @db.ObjectId // loose socket: links an issue line to its planned kit line
  scannedCode  String? // the decoded barcode (issue/return only)
  damagePhotoUrl String? // Cloudinary URL (required when condition = damaged)
  damageReason   String? // required when condition = damaged
  notes     String?

  createdAt DateTime @default(now())

  @@index([movementId])
  @@index([irmItemId])
}

// Engineer-held CUSTOMER consignment stock — the customer-side twin of EngineerStockBalance.
model EngineerCustomerStockHolding {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  customerStockEntryId String @db.ObjectId
  engineerId           String @db.ObjectId
  engineer             User   @relation("EngineerCustomerStockOwner", fields: [engineerId], references: [id])

  customerId   String? @db.ObjectId // snapshot for filtering by customer
  customerName String? // snapshot — human-readable customer label
  itemName     String  // snapshot
  quantityOnHand Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerStockEntryId, engineerId])
  @@index([engineerId])
  @@index([customerId])
}

// Immutable, append-only engineer customer-stock ledger.
model EngineerCustomerStockTransaction {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  customerStockEntryId String @db.ObjectId
  engineerId           String @db.ObjectId

  quantityDelta Int // + issue | − return/consume/lost
  type          String // job_issue | job_return | job_consume | job_lost
  sourceType    String // goods_management
  sourceId      String   @db.ObjectId
  sourceCode    String? // snapshot, e.g. GM-0001
  balanceAfter  Int
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([customerStockEntryId, engineerId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

// ── Engineer-to-engineer stock transfer (request → holder approves) ──────────────────────────
// A van-to-van move of an engineer's on-hand holdings to another engineer, gated by the HOLDER's
// approval. Ownership is preserved per line (company IRM vs customer consignment). Code ENG-####
// via the shared Counter. Loose sockets (no relations) — snapshots cover all reads. Stock moves
// only on completion; pending requests hold no balance.
model EngineerStockTransfer {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // ENG-0001

  status String @default("pending") // pending | completed | declined | cancelled

  // Holder (source, the approver) and recipient (needs the stock) — snapshots, history-safe.
  fromEngineerId    String  @db.ObjectId
  fromEngineerName  String
  fromEngineerEmail String?
  fromEngineerPhone String? // snapshot so the recipient can call the holder to coordinate handover
  toEngineerId      String  @db.ObjectId
  toEngineerName    String
  toEngineerEmail   String?

  // Who created the request.
  requestedById    String  @db.ObjectId // actor user id (recipient engineer, or an admin)
  requestedByEmail String?
  requestedByKind  String // engineer | admin

  reason      String
  notes       String?
  jobId       String?  @db.ObjectId // optional reference
  customerId  String?  @db.ObjectId // optional reference
  attachments String[] // evidence image URLs (Cloudinary)

  // Lifecycle / approval.
  approvedBy      String?
  approvedAt      DateTime?
  overrideByAdmin Boolean   @default(false) // admin force-completed a pending request
  declinedBy      String?
  declinedAt      DateTime?
  declineReason   String?
  cancelledAt     DateTime?
  completedAt     DateTime?

  // Receiver acknowledgment (configurable via Settings; snapshot at create time).
  requireSignature     Boolean   @default(false)
  receiverSignatureUrl String?
  acknowledgedAt       DateTime?

  lines     EngineerStockTransferLine[]
  createdBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([fromEngineerId, status])
  @@index([toEngineerId, status])
  @@index([createdAt])
}

model EngineerStockTransferLine {
  id         String                @id @default(auto()) @map("_id") @db.ObjectId
  transferId String                @db.ObjectId
  transfer   EngineerStockTransfer @relation(fields: [transferId], references: [id])

  ownership            String  // company | customer
  irmItemId            String? @db.ObjectId // when company (loose socket)
  customerStockEntryId String? @db.ObjectId // when customer (loose socket)

  itemName String // snapshot
  sku      String? // snapshot
  uom      String? // snapshot
  quantity Int

  // Set when this transfer FULFILS a job kit request — attributes the received qty to that job kit
  // line on completion (writes an attribution JobStockMovement so the job's Issued tally rises).
  // Loose socket, mirrors JobStockMovementLine.jobKitLineId. Null for ordinary van-to-van transfers.
  jobKitLineId String? @db.ObjectId

  createdAt DateTime @default(now())

  @@index([transferId])
  // Read by findVanSourcesByKitLines on hot paths (job detail, goods-management queue, scan, return),
  // which filters transfer lines by the kit line they fulfil. Without this it's a collection scan.
  @@index([jobKitLineId])
}

// ── Additional-kit request (Field Engineer → Project Manager) ───────────────────────────────────
// A field engineer's in-app request for MORE kit on a job whose plan has already been issued (extra
// units of an item, or a brand-new item). The PM reviews and approves; approval GROWS the job's
// JobKitLine (reusing the edit-job merge + issued-line locks) and opens fulfilment — a warehouse
// issue (Goods Management) or a job-scoped engineer→engineer transfer. Captures who asked + why,
// closing the traceability gap plain edit-job leaves.
// See docs/superpowers/specs/2026-07-06-job-additional-kit-request-design.md
model JobKitRequest {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // JKR-#### (atomic Counter, like GM/ENG/JOB)

  status String @default("pending") // pending | approved | declined | cancelled

  // The job this request grows. Loose socket (no relation) — mirrors EngineerStockTransfer.jobId.
  jobId     String @db.ObjectId
  jobNumber String // snapshot (JOB-YYYY-####)

  // Requester — the field engineer (snapshots, history-safe).
  requestedByEngineerId    String  @db.ObjectId
  requestedByEngineerName  String
  requestedByEngineerEmail String?

  reason      String
  notes       String?
  attachments String[] // optional evidence image URLs (Cloudinary)

  // Review (the PM / planner).
  reviewedByUserId String?   @db.ObjectId
  reviewedByEmail  String?
  reviewedAt       DateTime?
  decisionNote     String?
  // Request-level summary of how it was fulfilled: warehouse_issue | engineer_transfer | mixed.
  // "mixed" means the PM sourced different lines from different places — the authoritative per-line
  // detail lives on JobKitRequestLine.sourceType/sourceEngineerId. Kept as a single field (not
  // removed) so list views and history keep a one-glance answer.
  fulfillmentMode  String?
  // DEPRECATED for new approvals — retained so already-approved requests keep resolving their
  // transfer. Mixed/multi-engineer fulfilment opens one transfer per source engineer, recorded in
  // transferIds; readers should prefer transferIds and fall back to this.
  transferId       String?  @db.ObjectId
  // Every EngineerStockTransfer opened on approve (one per distinct source engineer). Empty for a
  // pure warehouse issue. The approve flow stamps this to stay resumable after a crash.
  transferIds      String[] @db.ObjectId

  lines     JobKitRequestLine[]
  createdBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId, status])
  @@index([requestedByEngineerId, status])
  @@index([status])
  @@index([createdAt])
}

model JobKitRequestLine {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  requestId String        @db.ObjectId
  request   JobKitRequest @relation(fields: [requestId], references: [id])

  source               String  // irm | customer_stock | misc
  irmItemId            String? @db.ObjectId // when irm (loose socket)
  customerStockEntryId String? @db.ObjectId // when customer_stock (loose socket)

  itemName String  // snapshot
  sku      String? // snapshot
  uom      String? // snapshot
  qty      Int // what the ENGINEER asked for — never rewritten, so the request stays a faithful record

  // What the reviewer actually approved, set on approve. NULL = approved in full (also every row
  // predating the trim), so readers fall back to `qty`. ZERO = the line was EXCLUDED — refused
  // individually while the rest of the request went through. Stored because the grown kit alone
  // can't answer "what did they ask for versus what did they get": an excluded line leaves no kit
  // line at all, so without this the request history silently loses the refusal.
  approvedQty Int?

  // Set on approve → the JobKitLine this request line grew (loose socket, mirrors
  // JobStockMovementLine.jobKitLineId). Lets a transfer fulfilment attribute its qty to the kit line.
  jobKitLineId String? @db.ObjectId

  // ── Per-line fulfilment source (set on approve) ──────────────────────────────────────────────
  // Stock for a kit request rarely sits in one place: the warehouse may hold some items while
  // another engineer's van holds the rest. So the SOURCE is chosen per line, not per request.
  //   warehouse → collected from sourceWarehouseId (a Goods-Management issue, as before)
  //   engineer  → transferred from sourceEngineerId's van (joins that engineer's transfer)
  // A line MAY be split across both: part comes off the van, the remainder is collected from the
  // warehouse. Such a line carries BOTH ids and is stamped sourceType = engineer, so the two ids are
  // NOT mutually exclusive — never pick one by reading sourceType alone or you drop the pickup
  // location for the remainder. Only a line coming WHOLLY from a van has no warehouse of its own.
  // Null on pending/declined requests and on rows approved before per-line sourcing shipped; readers
  // must fall back to the request-level fulfillmentMode for those.
  sourceType        String? // warehouse | engineer — the PRIMARY source; engineer may still have a warehouse
  sourceWarehouseId String? @db.ObjectId // warehouse-sourced, or the remainder of a split (misc lines stay null)
  sourceEngineerId  String? @db.ObjectId // set when any part of the line comes off a van

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ── Van Stock Request (engineer ↔ warehouse, NON-job) ──────────────────────────────────────────
// The non-job twin of the JKR/GM pair: restock (warehouse → van, reviewed) and return (van →
// warehouse, no review gate — scan-in IS acceptance). The request is the source document (like
// StockAdjustment); postings write the existing inventory/engineer/damaged ledgers with VSR-####
// provenance. See docs/superpowers/specs/2026-07-14-van-stock-request-design.md
model VanStockRequest {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // VSR-#### (atomic Counter)

  type       String // restock | return
  status     String @default("pending") // pending | approved | partially_fulfilled | fulfilled | declined | cancelled
  priority   String @default("normal") // normal | high | urgent
  createdVia String @default("engineer_request") // engineer_request | walk_in

  engineerId    String @db.ObjectId
  engineer      User   @relation("VanStockRequestEngineer", fields: [engineerId], references: [id])
  engineerName  String // snapshot
  engineerEmail String? // snapshot

  // Engineer's collection warehouse (REQUIRED on restock create — routes the pending request to
  // that warehouse's queue); the reviewer confirms/overrides the FINAL warehouse on approve.
  // Returns carry the final warehouse from create. Name/code are snapshots for list + worklist links.
  preferredWarehouseId   String? @db.ObjectId
  preferredWarehouseName String? // snapshot
  preferredWarehouseCode String? // snapshot
  warehouseId          String?    @db.ObjectId
  warehouse            Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseName        String? // snapshot (once final)
  warehouseCode        String? // snapshot (once final)

  reason      String
  notes       String?
  attachments String[] // request-level evidence (Cloudinary URLs)

  reviewedByUserId String?   @db.ObjectId
  reviewedByEmail  String?
  reviewedAt       DateTime?
  decisionNote     String?

  lastFulfilledAt DateTime? // stamped on every posting (drives the stale indicator)
  completionType  String? // complete | closed_short | cancelled_remaining — set when status → fulfilled
  closedShortBy   String? // actor email
  closedShortAt   DateTime?
  closeShortNote  String?
  cancelledAt     DateTime?

  lines       VanStockRequestLine[]
  fulfilments VanStockFulfilment[]

  createdBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([engineerId, status])
  @@index([warehouseId, status])
  @@index([createdAt])
}

model VanStockRequestLine {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  requestId String          @db.ObjectId
  request   VanStockRequest @relation(fields: [requestId], references: [id])

  irmItemId String @db.ObjectId // loose socket — company IRM only
  itemName  String // snapshot
  code      String? // snapshot — the IRM item code (e.g. IRM-0002), shown + copyable in the UI
  sku       String? // snapshot
  uom       String? // snapshot

  requestedQty Int
  approvedQty  Int? // set on approve (reviewer may trim); returns: = requestedQty at create
  fulfilledQty Int  @default(0) // accumulates across postings

  // Per-line source (restock): the warehouse that ISSUES this line — i.e. where the engineer collects
  // it. Set on approve; defaults to the request's warehouseId. Returns/walk-in: = req.warehouseId for
  // every line (no split). A real relation so the engineer's view can show the warehouse's LIVE address
  // on a split (they have no warehouse-module access, and "collect from <primary>" would send them to
  // the wrong place); name/code stay snapshotted so the line still reads correctly after a rename or if
  // the warehouse is later removed. Mirrors JobKitLine.warehouse.
  sourceWarehouseId   String?    @db.ObjectId
  sourceWarehouse     Warehouse? @relation(fields: [sourceWarehouseId], references: [id])
  sourceWarehouseName String?
  sourceWarehouseCode String?

  // Per-warehouse REVIEW: each source warehouse decides its OWN lines, so the decision has to be
  // recorded per line. The request-level reviewedBy/reviewedAt/decisionNote can only hold one
  // decision — whoever acted second overwrote the first, crediting one manager for another's call and
  // erasing their note. approvedQty stays the decision marker (null = undecided, 0 = excluded).
  reviewedByEmail String?
  reviewedAt      DateTime?
  decisionNote    String?

  // Per-warehouse close-short: the source warehouse that owns this line writes off its outstanding qty.
  closedShortQty  Int?
  closedShortBy   String?
  closedShortNote String?
  closedShortAt   DateTime?

  // Per-line CANCELLATION by the engineer ("cancel remaining" — they no longer need it). Deliberately
  // NOT reusing closedShort*: that is the WAREHOUSE saying it cannot supply, this is the REQUESTER
  // saying they no longer want it. Folding them together would attribute the engineer's decision to
  // the warehouse in its own queue. Both zero the line's outstanding qty; only the story differs.
  cancelledQty Int?
  cancelledBy  String?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([irmItemId])
  @@index([sourceWarehouseId])
}

// One row per POSTING event (a scan session that was posted). Restock lines are always "good";
// return lines split good/damaged with mandatory photo + reason on damaged (GM rules).
model VanStockFulfilment {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  requestId String          @db.ObjectId
  request   VanStockRequest @relation(fields: [requestId], references: [id])

  sequence    Int // 1, 2, 3… per request
  performedBy String // actor email snapshot
  postedAt    DateTime @default(now())

  lines VanStockFulfilmentLine[]

  @@index([requestId])
  // Two reviewers posting concurrently on a SPLIT restock (different source warehouses, the exact
  // concurrency this feature exists for) both read fulfilments.length and compute the same next
  // sequence. The line-qty guard keeps stock correct, but the audit trail would get two "#2"s that
  // render in nondeterministic order. This makes the collision a P2002 the poster retries instead.
  @@unique([requestId, sequence])
}

model VanStockFulfilmentLine {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  fulfilmentId String             @db.ObjectId
  fulfilment   VanStockFulfilment @relation(fields: [fulfilmentId], references: [id])

  lineId    String @db.ObjectId // the VanStockRequestLine fulfilled (loose socket)
  irmItemId String @db.ObjectId // loose socket
  itemName  String // snapshot

  qty            Int
  condition      String  @default("good") // good | damaged (returns only)
  damagePhotoUrl String? // required when damaged (Cloudinary URL)
  damageReason   String? // required when damaged
  scannedCode    String? // decoded barcode

  createdAt DateTime @default(now())

  @@index([fulfilmentId])
}

// Damaged-stock pool (write-off). Both owner types; never re-enters usable stock in v1.
model DamagedStockBalance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  ownerType String // company | customer
  irmItemId String?  @db.ObjectId
  irmItem   IrmItem? @relation(fields: [irmItemId], references: [id])
  customerStockEntryId String? @db.ObjectId // loose socket
  customerId           String? @db.ObjectId // loose socket (customer-owned damage)

  itemName String // snapshot
  quantity Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One balance row per natural key (the find-or-create key in the repo). Guarantees concurrent
  // damage reports for the same item+warehouse increment a single row instead of racing to insert
  // duplicates. The two loose sockets are null for the other owner type, which MongoDB indexes as
  // distinct tuples — so company (irmItemId set) and customer (customerStockEntryId set) rows never collide.
  @@unique([warehouseId, ownerType, irmItemId, customerStockEntryId])
  @@index([warehouseId])
  @@index([ownerType])
  @@index([customerId])
}

// Immutable, append-only damaged-stock ledger.
model DamagedStockTransaction {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  warehouseId String @db.ObjectId

  ownerType String // company | customer
  irmItemId String? @db.ObjectId
  customerStockEntryId String? @db.ObjectId
  customerId           String? @db.ObjectId

  quantityDelta Int // + report damaged, − restored back to usable
  reason        String
  notes         String?
  photoUrl      String?
  sourceType    String // goods_management_return | van_stock_return | warehouse_damage_report | damaged_restore
  sourceId      String   @db.ObjectId
  sourceCode    String? // GM-0001 / VSR-0001 — null for warehouse_damage_report (no parent document)
  balanceAfter  Int
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([warehouseId])
  @@index([customerId])
  @@index([sourceType, sourceId])
  // The BALANCE's natural key + time. Both ledger reads walk exactly these fields in newest-first
  // order — the damaged list's latest-reason/photo lookup (findLatestDamagedTxnsByBalances) and the
  // per-row history drill-down (findDamagedTxnsByKey). Without it only `warehouseId` was indexed, so
  // both seeked on the warehouse and then filtered + SORTED IN MEMORY; on a warehouse with a long
  // damage history that is a growing scan, and a large enough in-memory sort eventually trips
  // MongoDB's 32 MB sort ceiling and fails the request outright. createdAt is last so the index
  // serves the ordering as well as the match.
  @@index([warehouseId, ownerType, irmItemId, customerStockEntryId, createdAt])
}

// Per-job goods status (one row per Job). Derived tallies are computed from movement lines.
model JobStockSummary {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  jobId String @unique @db.ObjectId
  job   Job    @relation(fields: [jobId], references: [id])

  goodsStatus    String  @default("not_issued") // not_issued | partially_issued | issued | awaiting_return | reconciled
  workSummary    String?
  lastMovementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsStatus])
}

// Employee master-data: a department a staff member belongs to (e.g. "Operations").
// Managed (create/rename/delete) from Users & Roles; the user form picks from this
// list or creates one inline. User.department stores the chosen NAME (denormalized),
// so existing records stay valid and removing a department never orphans a user.
model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Display name exactly as typed ("Operations"). Not unique on its own — the
  // case-insensitive guard lives on `nameLower` so "Operations" and "operations"
  // can't both exist.
  name      String
  // Lowercased `name`, kept in sync by the repository on every write. The @unique
  // index here is what actually enforces case-insensitive uniqueness at the DB —
  // the application pre-check is just for a friendly message.
  nameLower String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Employee master-data: a job title / designation (e.g. "Field Engineer"). Managed
// from Users & Roles; the user form picks from this list or creates one inline.
// User.jobTitle stores the chosen NAME (denormalized), so a rename cascades and a
// removal never orphans a user. Case-insensitive uniqueness via nameLower (same
// pattern as Department).
model JobTitle {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  nameLower String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staff member the Super Admin (or a delegate with users.create) adds from the
// admin panel. Created with a secure temporary password (bcrypt hash, never sent
// to the client); logs in and is governed by RBAC via the assigned role.
model User {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String  @unique
  phone           String?
  roleId          String? @db.ObjectId
  role            Role?   @relation(fields: [roleId], references: [id])
  status          String  @default("active") // active | inactive | suspended
  profileImageUrl String?
  notes           String?

  // Personal signature — printed on documents the user issues (e.g. the Purchase Order PDF).
  // One per user, uploaded under My Account; reuses the Cloudinary image pipeline. All optional.
  signatureUrl        String?
  signatureName       String?
  signatureMimeType   String?
  signatureFileSize   Int?
  signatureUploadedAt DateTime?
  signatureUpdatedAt  DateTime?

  // Employment record.
  employeeId    String?   @unique // human staff reference, auto-generated (e.g. SNT-0007)
  jobTitle      String? // designation, e.g. "Field Engineer"
  department    String? // team, e.g. "Operations"
  dateOfJoining DateTime?

  // Personal details (optional).
  gender      String? // male | female | other | unspecified
  dateOfBirth DateTime?

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?

  // Auth — set at creation, never sent to the browser.
  passwordHash      String
  mustResetPassword Boolean @default(true)
  // First-login "set your password" + forgot-password flow: SHA-256 hash of the
  // emailed token + its expiry (never the raw token).
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  deletedAt DateTime? // soft delete — excluded from listings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Explicit warehouse assignments (for warehouse-scoped roles). Rows PERSIST across role changes —
  // only removed on permanent user delete or explicit admin un-assignment (back-relation).
  warehouseAssignments UserWarehouseAssignment[]
  // Engineer-held stock (back-relation; no DB column).
  engineerStockBalances     EngineerStockBalance[]     @relation("EngineerStockOwner")
  engineerStockTransactions EngineerStockTransaction[] @relation("EngineerStockTxnOwner")
  // Field jobs assigned to this engineer (back-relation; no DB column).
  assignedJobs              Job[]                      @relation("JobAssignedEngineer")
  // Goods Management (back-relations; no DB column).
  jobStockMovements              JobStockMovement[]              @relation("JobStockMovementEngineer")
  engineerCustomerStockHoldings  EngineerCustomerStockHolding[]  @relation("EngineerCustomerStockOwner")
  // Non-job van stock requests raised by this engineer (back-relation; no DB column).
  vanStockRequests               VanStockRequest[]               @relation("VanStockRequestEngineer")

  @@index([roleId])
  @@index([status])
}

// Explicit user↔warehouse assignment (many-to-many) for warehouse-scoped roles (e.g. Warehouse
// Manager). A scoped user may ONLY access the warehouses they have a row for here — enforced on
// EVERY warehouse-bound endpoint via the principal's assignedWarehouseIds. Normalized junction (no
// JSON arrays / CSV ids). Rows PERSIST across role changes (a user demoted then re-promoted keeps
// their warehouses); they are removed ONLY on permanent user delete or explicit admin un-assignment.
// MongoDB has no FK cascade, so deletes are done in the application/repository layer.
model UserWarehouseAssignment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  assignedAt  DateTime  @default(now())
  assignedBy  String? // staff email that made the assignment

  @@unique([userId, warehouseId]) // a user can't be assigned the same warehouse twice
  @@index([userId])
  @@index([warehouseId])
}

// A customer company (e.g. "BT"). Created by an admin/PM from the dashboard; the
// record IS the login identity (one read-only login per customer — company email +
// temp password, mirroring the staff User auth fields). A Customer PM signs in and
// gets READ-ONLY, single-customer-scoped visibility of their own stock (Flow 9).
// Customer codes are Counter-allocated (e.g. CUST-001), same pattern as employeeId.
model Customer {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  customerCode  String  @unique // human reference, auto-generated (e.g. CUST-001)
  name          String // company name, e.g. "BT"
  // Lowercased `name`, kept in sync by the repository on every write. NOT a hard
  // unique index (a soft-deleted row would otherwise permanently block re-using a
  // company name); case-insensitive name uniqueness is checked among ACTIVE
  // customers in the service. `email` is the hard unique login identity.
  nameLower     String

  // Company details.
  legalName          String? // legal / registered company name (distinct from trading name)
  registrationNumber String? // company / registration number
  industry           String? // sector, e.g. "Telecoms"
  website            String?
  logoUrl            String? // Cloudinary URL (company logo)
  notes              String? // internal notes (never shown to the customer)
  status             String  @default("active") // active | inactive

  // Primary contact (the portal login belongs to this person).
  contactPerson   String?
  contactJobTitle String?
  email           String  @unique // login identity (company email)
  phone           String?
  altPhone        String? // secondary phone

  // Address (UK).
  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? // defaults to "United Kingdom" in the UI

  // The login identity now lives on CustomerUser (a person signs in, not the
  // company). `email` above is just the company's primary-contact email.

  deletedAt DateTime? // soft delete — excluded from listings

  // Audit — staff email that created / last updated this record (null for legacy rows).
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      CustomerProject[]
  sites         CustomerSite[]
  users         CustomerUser[]
  stockRequests CustomerStockRequest[]
  stockEntries  CustomerStockEntry[]
  // Field jobs raised for this customer (back-relation; no DB column).
  jobs          Job[]

  @@index([status])
}

// A customer's project (e.g. "BT Core Migration"). 1-to-many. Later feeds the
// "Select Project" dropdown when creating jobs. Case-insensitive unique per customer.
model CustomerProject {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String    @db.ObjectId
  customer    Customer  @relation(fields: [customerId], references: [id])
  // Per-customer reference, auto-generated by the atomic counter (e.g. PRJ-0001).
  // Required: the service always allocates one on create (DB is clean of legacy rows).
  code        String
  name        String
  nameLower   String    // lowercased name; uniqueness scoped per-customer via @@unique
  type        String?   // project type, e.g. "Migration" | "Rollout"
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active") // active | planned | on_hold | completed
  description String?
  // Field jobs under this project (back-relation; no DB column).
  jobs        Job[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, nameLower])
  @@index([customerId])
}

// A customer site / delivery location (optional). name + UK postcode.
model CustomerSite {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id])
  // Per-customer reference, auto-generated by the atomic counter (e.g. STE-0001).
  // Required: the service always allocates one on create (DB is clean of legacy rows).
  code          String
  name          String
  // Address (UK) — structured, matching Warehouse/Supplier/Customer. `addressLine1` keeps the
  // legacy `addressLine` DB key (@map) so existing single-line site addresses survive as line 1.
  addressLine1  String?  @map("addressLine")
  addressLine2  String?
  city          String?
  county        String?
  postcode      String?
  country       String? // defaults to "United Kingdom" in the UI
  contactPerson String?
  contactNumber String?
  latitude      Float?
  longitude     Float?
  status        String   @default("active") // active | inactive
  // Field jobs at this site (back-relation; no DB column).
  jobs          Job[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Unique per customer + code: defense-in-depth so a code-allocation bug fails loudly
  // instead of silently duplicating. Also serves the customerId lookups. Codes are
  // counter-allocated, so existing data already satisfies this.
  @@unique([customerId, code])
}

// A customer's portal user (e.g. their PM) — and the customer's LOGIN identity.
// 1-to-many under a company; each user signs in with their own email + password.
// One user type for now (no per-user roles). `email`/`emailLower` are globally
// unique (the customer login namespace); auth fields mirror the staff User.
model CustomerUser {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String    @db.ObjectId
  customer    Customer  @relation(fields: [customerId], references: [id])
  fullName    String
  email       String
  emailLower  String    @unique // lowercased login email — globally unique
  phone       String?
  designation String?   // job title / role label (free text)
  status      String    @default("active") // active | inactive

  // Auth — set when the user is invited; never sent to the browser. Optional so a
  // pre-existing contact row still reads (it just can't log in until invited).
  passwordHash        String?
  mustResetPassword   Boolean?  @default(true)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  lastLoginAt         DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
}

// A customer-submitted STOCK REQUEST — an inbound stock notification. A portal user
// (or PM on their behalf) declares "these items are coming" with a quantity + reason;
// an internal user reviews, edits the item name to match the catalogue, assigns
// warehouse(s), and the warehouse manager receives the physical goods.
// Status machine: pending → approved → assigned → partially_received → completed
//                                   → rejected
model CustomerStockRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id])
  name        String   // requested item name (free text from customer)
  // quantity + reason are MANDATORY in validation (zod), but DB-nullable on purpose:
  // Prisma+MongoDB throws reading a doc that LACKS a required field, so new required
  // fields stay nullable at the DB and the API enforces them.
  quantity    Int?
  reason      String?  // business justification (app-required)
  notes       String?
  status            String    @default("pending") // pending | approved | assigned | partially_received | completed | rejected
  requestedByUserId String?   @db.ObjectId
  requestedByName   String?
  reviewedBy        String?   // staff email that approved / rejected
  adminResponse     String?   // admin response notes (shown to the customer)
  reviewedAt        DateTime?

  // PM edits: corrected item name + optional link to catalogue item.
  editedName        String?   // PM-corrected name (e.g. "spf" → "SFP-LX")
  catalogueItemId   String?   @db.ObjectId // optional link (legacy, being phased out)

  // Optional link to an existing received stock line (CustomerStockEntry) this
  // submission is a TOP-UP of. When set, receiving the stock adds to that product's
  // existing quantity (matched by product + warehouse) instead of creating a duplicate.
  linkedStockEntryId String?  @db.ObjectId

  // Warehouse assignments (back-relation; no DB column).
  warehouseAssignments CustomerStockWarehouseAssignment[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
  // Standalone status index for the attention count, which asks "how many pending across the whole
  // company?" with no customerId — a [customerId, status] compound cannot serve that (status is not
  // a left prefix), so without this the count is a full collection scan on every attention load.
  @@index([status])
}

// A warehouse allocation for a customer stock request. One request can be split across
// multiple warehouses (e.g. 10 SFP-LX → 6 Leeds + 4 London). The warehouse manager
// receives stock against each assignment independently. Partial delivery is supported.
model CustomerStockWarehouseAssignment {
  id                     String               @id @default(auto()) @map("_id") @db.ObjectId
  customerStockRequestId String               @db.ObjectId
  stockRequest           CustomerStockRequest @relation(fields: [customerStockRequestId], references: [id])
  warehouseId            String               @db.ObjectId
  warehouse              Warehouse            @relation(fields: [warehouseId], references: [id])

  quantity               Int     // how many assigned to this warehouse
  receivedQuantity       Int     @default(0) // how many actually received so far
  // pending | partially_received | received | closed_short
  //
  // `received` means receivedQuantity reached quantity. `closed_short` is the OTHER terminal state:
  // the balance is never coming (the customer shipped less than they declared, part was lost in
  // transit, they rescoped the order…). Without it a short delivery sat in the warehouse's Incoming
  // queue forever with a Receive button, and its parent request could never reach `completed`.
  // Kept distinct from `received` on purpose — merging them would make "arrived in full" unreportable.
  status                 String  @default("pending")

  receivedBy             String? // staff email that received the stock
  receivedAt             DateTime?
  notes                  String?

  // Short-closure trail. `closureReason` is app-REQUIRED (zod) but DB-nullable, matching how
  // CustomerStockRequest.reason is modelled — closing without saying why is the thing that makes a
  // stalled delivery unanswerable months later.
  closedAt               DateTime?
  closureReason          String?
  closedBy               String? // staff email that closed it short

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([customerStockRequestId, warehouseId])
  @@index([customerStockRequestId])
  @@index([warehouseId, status])
  // The [warehouseId, status] compound above serves a warehouse-SCOPED actor. An unrestricted actor
  // (admin, or any role without warehouse scoping) counts on status alone, which that compound can't
  // serve — hence the standalone index. Same reason as CustomerStockRequest.
  @@index([status])
}

// A physical stock entry created when customer stock is received at a warehouse.
// Starts as "draft" (basic info from the assignment) — the warehouse manager then
// fills in the product details (like catalogue fields) and optionally generates a
// barcode. Separate from IRM inventory (customer-owned stock, no pricing).
model CustomerStockEntry {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String    @db.ObjectId
  customer      Customer  @relation(fields: [customerId], references: [id])
  warehouseId   String    @db.ObjectId
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  assignmentId  String?   @db.ObjectId // links back to CustomerStockWarehouseAssignment (null for direct adds)

  // Product details — mandatory fields filled by warehouse manager after receipt.
  itemName      String    // pre-filled from editedName / request name
  sku           String?   // manual or auto-generated
  categoryId    String?   @db.ObjectId
  category      Category? @relation("CustomerStockEntryCategory", fields: [categoryId], references: [id])
  description   String?
  uom           String?   // unit of measure (Each / Metre / Box etc.)
  quantity      Int       // received quantity
  // NOTE: serialized / serialNumber / highValue are NOT surfaced anywhere the user sets them —
  // no form collects them (the Add-stock-entry Tracking section was removed) and no receive/request
  // flow captures them, so in practice they are always the default `false`/null. They stay here only
  // because stock-position `flags` still reads them (harmlessly false) and StockEntryDetail passes the
  // existing value straight through on edit. Don't be misled into thinking this is a live feature.
  serialized    Boolean   @default(false)
  serialNumber  String?   // if serialized (unused — see note above)
  highValue     Boolean   @default(false) // unused — see note above
  thresholdQty  Int?      // low-stock reorder threshold
  attributes    Json?     // dynamic per-category custom fields

  // Barcode — generated on demand, stored for print / scan. `barcode` is UNIQUE across all rows,
  // enforced by a PARTIAL unique index (customerRepo.ensureStockEntryBarcodeUniqueIndex) — do NOT
  // add `@unique` here: a plain @unique on an optional field builds a NON-sparse index that rejects
  // a second null, and draft entries have no barcode yet (prisma/prisma#23870). Uniqueness is
  // load-bearing: scanning resolves this with findFirst, so a duplicate silently returns another
  // CUSTOMER's stock. The index also keeps the scan lookup off a collection scan.
  barcode         String?  // the barcode value string (e.g. "CSE-00001")
  barcodeDataUri  String?  // base64 data URI of the rendered barcode image

  status        String    @default("draft") // draft | active
  receivedBy    String?   // staff email that received the stock
  receivedAt    DateTime? // when physically received

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([warehouseId, status])
  @@index([assignmentId])
  // Unscoped actors count drafts on status alone — see CustomerStockWarehouseAssignment.
  @@index([status])
}

// ── JOBS — field-work job pack (header + kit lines) ─────────────────────────────────────
// A field-work job raised for a customer/project, optionally tied to a CustomerSite (or
// free-text site address), assigned to an engineer (staff User). jobNumber is Counter-
// allocated per-year (JOB-2026-0001), same atomic mechanism as GDN/PO codes (Counter key
// "JOB:<year>"). Status is a forward String machine enforced in the service (NOT a Prisma
// enum — matches every other model). Soft-deleted rows (deletedAt set) are excluded from
// normal reads; `deletedAt` is written EXPLICITLY as null on create. assignedEngineerId is
// app-required (zod) but DB-nullable (Prisma+Mongo reads break on an absent required field).
model Job {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  jobNumber String @unique // auto-allocated per year, e.g. JOB-2026-0001

  // Customer-facing references (the customer's own scheme/order numbers).
  customerRef String? // the customer's own reference for this job
  schemeNo    String? // scheme / order number, e.g. 5432471
  name        String
  jobType     String  @default("installation") // installation | survey | maintenance | decommission | other (app-validated)
  technology  String? // optional, e.g. "WDM" | "Fibre"

  // Customer + project (required relations — every job belongs to a customer + project).
  // Names are snapshotted at create/edit (history-safe after a rename), same as goods-out.
  customerId   String   @db.ObjectId
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String? // snapshot
  projectId    String          @db.ObjectId
  project      CustomerProject @relation(fields: [projectId], references: [id])
  projectName  String? // snapshot

  // Site — EITHER a linked CustomerSite (optional relation) OR free-text site fields below.
  siteId String?       @db.ObjectId
  site   CustomerSite? @relation(fields: [siteId], references: [id])

  // Free-text site (used when no siteId). All optional. Structured UK address, matching
  // Warehouse/Customer. `addressLine1` keeps the legacy `address` DB key (@map) so existing
  // single-line job addresses survive as line 1.
  siteName     String?
  trsArea      String?
  addressLine1 String? @map("address")
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? // defaults to "United Kingdom" in the UI
  latitude     Float? // derived server-side from postcode (never hand-entered)
  longitude    Float?
  floor        String?
  suite     String?
  rack      String?
  shelf     String?

  completionDate DateTime?
  priority       String    @default("normal") // low | normal | high | urgent

  // Assigned engineer (app-required staff User; DB-nullable for the Prisma+Mongo reason above).
  assignedEngineerId    String? @db.ObjectId
  assignedEngineer      User?   @relation("JobAssignedEngineer", fields: [assignedEngineerId], references: [id])
  assignedEngineerName  String? // snapshot at assign-time (history-safe after renames)
  assignedEngineerEmail String? // snapshot

  // External supplier / installer (optional relation + flag).
  supplierId    String?   @db.ObjectId
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  supplierName  String? // snapshot
  installerType String    @default("internal") // internal | external

  status String @default("draft") // draft | assigned | accepted | in_progress | completed | cancelled

  // Planner contact (optional, snapshotted off the customer's pack).
  plannerName  String?
  plannerPhone String?

  notes       String?
  attachments String[] @default([]) // Cloudinary URLs of the original job-pack files

  // Kit lines (back-relation; no DB column).
  kitLines JobKitLine[]

  // Procurement raised against this job (back-relations; no DB column).
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]

  // Goods Management (back-relations; no DB column).
  stockMovements JobStockMovement[]
  stockSummary   JobStockSummary?

  // Workflow snapshots (who/when). Emails are snapshots, not FKs.
  assignedAt   DateTime?
  acceptedAt   DateTime?
  acceptedBy   String?   // engineer email that accepted
  rejectedAt   DateTime?
  rejectedBy   String?   // engineer email that rejected
  rejectReason String?   // why the engineer declined (shown to the PM)
  startedAt    DateTime? // when the engineer started work (accepted → in_progress)
  completedAt  DateTime? // when the engineer completed work (in_progress → completed)
  cancelledAt  DateTime?
  cancelReason String?

  // Audit — staff that created it. createdByUserId drives realtime "job:accepted" targeting
  // (no relation — a loose socket); createdBy is the email snapshot.
  createdByUserId String?   @db.ObjectId
  createdBy       String?   // staff email that created the job (snapshot)
  updatedBy       String?
  deletedAt       DateTime? // soft delete — excluded from listings; history stays intact

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([siteId])
  @@index([assignedEngineerId])
  @@index([supplierId])
  // Engineer-portal queries always filter on assignedEngineerId + (status | createdAt): the jobs list
  // (assignedEngineerId + deletedAt, sorted by createdAt) and the dashboard's active-jobs read
  // (assignedEngineerId + status). Mongo uses one index per query, so without these compounds each
  // falls back to scanning the engineer's whole job set in memory. Mirrors the compound every other
  // engineer-scoped model already has (VanStockRequest, JobKitRequest, EngineerStockTransaction).
  @@index([assignedEngineerId, status])
  @@index([assignedEngineerId, createdAt])
  // The admin dashboard's dueBreakdown filters active status + completionDate — give it a compound too.
  @@index([status, completionDate])
}

// A kit line on a Job — what the engineer needs to take/use. lineType selects the source
// pool: customer-owned consignment stock, the company IRM catalogue, or a free-text MISC item
// (services / patch cords / charges). Only the matching id is set per line (app-enforced).
// lineType is a String (NOT a Prisma enum) per the house convention. irmItemId is a real
// relation; customerStockEntryId is a loose socket (no relation).
model JobKitLine {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  jobId String @db.ObjectId
  job   Job    @relation(fields: [jobId], references: [id])

  lineType    String  // customer_stock | irm | misc
  seCode      String? // optional scheme/equipment code snapshot (the customer SKU / SE Code)
  itemName    String
  description String?

  // Source ids — at most one set per line, depending on lineType.
  customerStockEntryId String? @db.ObjectId // loose socket (no relation) — customer consignment line
  irmItemId            String?  @db.ObjectId
  irmItem              IrmItem? @relation(fields: [irmItemId], references: [id])

  // Pickup warehouse — WHERE the engineer collects this item. For customer_stock it's the entry's
  // own warehouse (derived server-side); for irm the PM picks it. misc lines have none. A real
  // relation so the engineer's job view can show the warehouse's LIVE address (they have no
  // warehouse-module access); name/code are also snapshotted so the line reads correctly after a
  // rename or if the warehouse is later removed.
  warehouseId   String?    @db.ObjectId
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseName String? // snapshot
  warehouseCode String? // snapshot

  qty   Int
  notes String?

  // Set true when a COMPLETED engineer→engineer transfer attributed van stock to this line. Van
  // stock owes no warehouse, so it's returnable at ANY warehouse; the Goods-Management queue keys its
  // candidate lookup off kit-line warehouses and would never surface such a line away from its home.
  // This denormalized flag lets the queue widen its candidate set with an INDEXED lookup instead of a
  // growing `id IN (…all van jobs…)` list. Stays true after full return (harmless — the service still
  // confirms per line that van stock is actually still returnable before showing the row).
  hasVanSource Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([irmItemId])
  @@index([warehouseId])
  @@index([hasVanSource])
}

// A dynamic, admin-editable email template. Every email the app sends is
// rendered from one of these (no hardcoded email content). `isSystem` templates
// ship a built-in default that can be restored but not deleted.
model EmailTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique // event key, e.g. "user.created"
  name        String // "User Created"
  category    String // account | security | notification
  subject     String
  htmlContent String
  textContent String
  variables   String[] @default([]) // supported {{vars}} (for UI hints)
  enabled     Boolean  @default(true)
  isSystem    Boolean  @default(false) // has a built-in default → restore / no-delete
  version     Int      @default(1) // bumps on each edit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Delivery log for every email send (templated or test). Failed-email tracking
// = rows where status = "failed"; retry-ready for a later phase.
model EmailLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  to          String
  subject     String
  templateKey String? // null for ad-hoc sends (e.g. a test email)
  status      String // sent | failed
  error       String?
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
}

// Immutable audit trail. The actor is snapshotted (id + email) so the entry
// stays meaningful even if that account is later renamed or removed.
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId     String?
  actorType   String   @default("admin") // admin | user | system
  actorEmail  String?
  action      String // "user.created", "role.deleted", ...
  targetType  String? // user | role | email_template
  targetId    String?
  targetLabel String? // snapshot, e.g. the user's email / role name
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// An active login session = one signed-in device. Tokens carry the `sid`, and
// requireAuth + refresh validate that the session row still exists — so logout
// and the 2-device cap (evicting the oldest session on a 3rd sign-in) take effect
// immediately. Rows are deleted on logout / password change.
model Session {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  sid           String   @unique // embedded in the access + refresh tokens
  principalId   String // the admin, user, or customer id (no FK — points at any collection)
  principalType String // "admin" | "user" | "customer"
  userAgent     String?
  ip            String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  expiresAt     DateTime // matches the refresh token's expiry

  @@index([principalId, principalType])
}

// A named, atomically-incrementing sequence. Used to hand out gap-free, collision-free
// running numbers — currently the employeeId suffix, one sequence per prefix. `key` is
// the sequence name (the employeeId prefix, e.g. "STR"); `seq` is the last value handed
// out. Allocation is a single atomic $inc on this one document, so concurrent callers
// can never receive the same number (no retry, no random fallback). On first use of a
// prefix the row is seeded from the highest existing id so it never reuses a number.
model Counter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // sequence name, e.g. the employeeId prefix "STR"
  seq       Int      @default(0) // last value handed out
  updatedAt DateTime @updatedAt
}

// Push-notification device tokens (Firebase Cloud Messaging). One row per device
// per signed-in user. The FCM token is globally unique — a device belongs to one
// user at a time, so re-registering it under a new user MOVES the row (upsert on
// token). No FK, like Session: `userId` points at the User collection by id.
model DeviceToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  token      String   @unique // FCM registration token
  userId     String   @db.ObjectId // the staff user this device is signed in as
  platform   String   @default("android") // android | ios
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}
