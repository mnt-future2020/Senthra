# Dependencies
node_modules/

# Environment variables — keep secrets (DB URL, JWT/refresh/encryption keys,
# admin password) OUT of version control. The template stays committed.
.env
.env.*
!.env.example

# TypeScript build output
dist/
*.tsbuildinfo

# Prisma generated client (only when a custom output path is configured)
/generated/prisma

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/

# local dev server log
dev.log

# Ad-hoc DB inspection / scratch scripts (never production code — kept out of the repo)
_inspect.mjs
_scratch.*
*.scratch.*

# Firebase service-account key — never commit
firebase-service-account*.json

# npm's lockfile — this app is pnpm (pnpm-lock.yaml is the tracked one).
# An `npm install` run here generates package-lock.json as a byproduct, and it has
# been swept into a commit by `git add .` before. Two lockfiles resolve independently,
# so pnpm and npm users end up on different dependency versions from the same commit —
# with nothing in the diff to explain it. Ignore it rather than rely on remembering.
package-lock.json
