# Copy to .env and fill in real values.

# MongoDB connection string (Prisma + MongoDB requires a replica set; Atlas works).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Port the Express server listens on.
PORT=8000

# --- Auth ---
# Initial admin account, seeded into the DB on first startup.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Two SEPARATE secrets (access + refresh). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"
REFRESH_SECRET="replace-with-a-different-long-random-string"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# AES-256-GCM key for encrypting secrets at rest (SMTP password, Google secret).
# 32 bytes / 64 hex chars. Keep it SEPARATE from the DB and out of source control.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# "production" enables Secure (HTTPS-only) cookies.
NODE_ENV="development"

# Frontend origin allowed by CORS (must be exact for credentialed requests).
FRONTEND_URL="http://localhost:3000"
# Optional cross-subdomain cookie domain in production, e.g. ".senthra.com"
# COOKIE_DOMAIN=""

# Cloudinary (image CDN) — for branding logo/favicon uploads. Get these from your
# Cloudinary dashboard (Settings → API Keys). Optional: image upload is disabled
# until all three are set; brand name / footer / tagline still work without them.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Signed upload presets, one per Cloudinary resource type. Create both in the
# Cloudinary dashboard (Settings → Upload → Upload presets) as SIGNED presets with
# an allowed-formats list: images png,jpg,jpeg,gif,webp — documents pdf,docx. They
# are what lets Cloudinary refuse a wrong file type at its own edge. Defaulted, so
# leave these unset unless the account uses different names; set one to "" to sign
# without a preset.
CLOUDINARY_UPLOAD_PRESET_IMAGE="senthra_image"
CLOUDINARY_UPLOAD_PRESET_RAW="senthra_raw"

# --- Firebase Cloud Messaging (push notifications to the engineer app) ---
# From the Firebase service-account JSON (Project settings → Service accounts →
# Generate new private key). Push is disabled until all three are set.
# FIREBASE_PRIVATE_KEY: paste the whole "private_key" value in quotes, keeping the
# literal \n sequences (do NOT convert them to real newlines) — the code un-escapes them.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Scheduled reports: how the sweep gets invoked ---
# The whole runtime contract is "call runDueSchedules() at least once an hour".
# Two ways, and BOTH are wired — see docs/reports-scheduler-runtime.md.
#
# 1. Long-running host (VPS, container, bare Node): server.ts sweeps for itself,
#    on by default. Nothing to set. Set REPORT_SCHEDULER_IN_PROCESS="false" only
#    where an external scheduler is the sole driver.
# 2. Platform scheduler (serverless cron, Kubernetes CronJob, plain crontab):
#    set REPORT_SCHEDULER_SECRET (>=16 chars, random) and have the scheduler call
#      POST /internal/report-scheduler/run
#    hourly with the secret in the x-scheduler-secret header (or Authorization:
#    Bearer, or ?secret=). While this is unset the endpoint answers 503 to
#    everyone — an endpoint that emails people is never open by default.
#
# Running both is safe: the database decides what has already run.
#
# ── ON VERCEL: TWO NAMES, ONE VALUE ───────────────────────────────────────────
# backend/vercel.json declares an hourly cron on the trigger path. Vercel Cron
# authenticates itself by sending
#     Authorization: Bearer $CRON_SECRET
# using its OWN environment variable, CRON_SECRET. This application reads
# REPORT_SCHEDULER_SECRET. They are two different variable names holding the
# SAME secret, and BOTH must be set in the Vercel project to the identical value:
#
#     CRON_SECRET              -> the same long random string
#     REPORT_SCHEDULER_SECRET  -> the same long random string
#
# Get this wrong and NOTHING TELLS YOU. Every hourly invocation is refused (401
# on a mismatch, 503 if REPORT_SCHEDULER_SECRET is unset), the sweep never runs,
# and no scheduled report is ever sent — the failure is silent by design, because
# the alternative is an endpoint that emails people to whoever asks. After
# deploying, confirm the cron in the Vercel dashboard shows 200s, not 401/503.
#
# Plan caveat: hourly crons need Vercel PRO. On Hobby, cron frequency is capped
# at once per day, so "0 * * * *" is rejected/downgraded and a schedule can be
# delivered up to a day late. A daily sweep still sends every report exactly once
# (the (scheduleId, periodStart) unique key decides that, not the sweep rate) —
# it only delays them. The always-on host in option 1 has no such limit.
#
# REPORT_SCHEDULER_SECRET="change-me-to-a-long-random-string"
REPORT_SCHEDULER_IN_PROCESS="true"
