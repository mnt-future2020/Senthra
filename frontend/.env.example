# Copy to .env. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the Senthra backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── "Quick login" one-tap shortcuts on the login page ────────────────────────────────────────
#
# The switch that shows the BUTTONS. Local dev shows them with nothing set; every other build —
# the client demo included — has to opt in here. Leave it unset on the real production deployment,
# so the shortcuts are off because nobody asked for them rather than because somebody remembered
# to say no.
# NEXT_PUBLIC_QUICK_LOGIN=true
#
# It hides the buttons. It does NOT keep the credentials out of the build — verified by building
# with the flag unset and the pair below set, and finding the password in .next/static. Every
# NEXT_PUBLIC_* value is INLINED INTO THE CLIENT BUNDLE at build time wherever the code reads it,
# so anyone who opens devtools can read it whether or not anything renders. No setting changes
# that; the ONLY thing that keeps a credential out of a build is not setting it for that build.
#
# So: set the pairs below where they will not outlive their use, and nowhere else.
#   · local     → .env.local (gitignored)
#   · demo      → the hosting provider's environment variables
#   · real prod → nowhere
# Do NOT commit them to any .env file. Deleting the file later does not remove them from git
# history, so "we'll take it out before launch" does not undo it.
#
# And point them only at accounts and data you would not mind a stranger signing into, because on
# a public URL that is the assumption you are making.
#
# A shortcut appears only when BOTH halves of its pair are set; leave a pair unset to hide it.
# NEXT_PUBLIC_QUICK_ADMIN_EMAIL=
# NEXT_PUBLIC_QUICK_ADMIN_PASSWORD=
# NEXT_PUBLIC_QUICK_CUSTOMER_EMAIL=
# NEXT_PUBLIC_QUICK_CUSTOMER_PASSWORD=
# NEXT_PUBLIC_QUICK_ENGINEER_EMAIL=
# NEXT_PUBLIC_QUICK_ENGINEER_PASSWORD=
# NEXT_PUBLIC_QUICK_FINANCE_EMAIL=
# NEXT_PUBLIC_QUICK_FINANCE_PASSWORD=
# NEXT_PUBLIC_QUICK_PM_EMAIL=
# NEXT_PUBLIC_QUICK_PM_PASSWORD=
