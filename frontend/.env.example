# Copy to .env. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base URL of the Senthra backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — dev-only "Quick login" shortcuts on the login page (compiled out of
# production builds). Set these in .env.local (gitignored) to THROWAWAY dev-account
# credentials; leave unset to hide a shortcut. Never put real/admin passwords here.
# NEXT_PUBLIC_QUICK_ADMIN_EMAIL=
# NEXT_PUBLIC_QUICK_ADMIN_PASSWORD=
# NEXT_PUBLIC_QUICK_CUSTOMER_EMAIL=
# NEXT_PUBLIC_QUICK_CUSTOMER_PASSWORD=
# NEXT_PUBLIC_QUICK_USER_EMAIL=
# NEXT_PUBLIC_QUICK_USER_PASSWORD=
